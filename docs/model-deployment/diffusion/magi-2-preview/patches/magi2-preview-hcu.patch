+# Copyright (c) 2026 SandAI. All Rights Reserved.
+"""Bounded CPU conversion of decoded, channel-first video tensors."""
+
+import numpy as np
+import torch
+
+
+def cpu_video_to_uint8(video: torch.Tensor) -> np.ndarray:
+    """Keep the original FP32 operations, with at most 28 frames per contiguous-input temporary.
+
+    The caller selects CPU BF16 decoder outputs. Contiguous inputs use channel-first
+    storage exposed as (N, T, H, W, C) or (T, H, W, C). Other layouts use the original
+    whole-video conversion to preserve NumPy strides.
+    No input storage is modified or retained between calls.
+    """
+    if video.device.type != "cpu" or video.dtype != torch.bfloat16:
+        raise ValueError("expected a CPU BF16 decoded video")
+    if video.ndim not in (4, 5):
+        raise ValueError("expected CTHW or NCTHW decoded video")
+    temporal_axis = video.ndim - 3
+    permutation = (0, 2, 3, 4, 1) if video.ndim == 5 else (1, 2, 3, 0)
+    if not video.is_contiguous() or video.shape[temporal_axis] <= 28:
+        # Preserve original layout and singleton strides outside the chunked path.
+        normalized = video.float().mul(0.5).add(0.5).clamp(0, 1)
+        return normalized.permute(permutation).mul(255).numpy().astype(np.uint8)
+    # Avoid NumPy's explicit huge-page advice for this short-lived output.
+    # The NumPy view retains the CPU tensor storage without an extra copy.
+    output = torch.empty(video.shape, dtype=torch.uint8, device="cpu").numpy()
+    output = output.transpose(permutation)
+    # Keep one FP32 scratch for this call. Each in-place operation retains its
+    # original FP32 rounding boundary; the decoded BF16 input is never changed.
+    scratch_shape = list(video.shape)
+    scratch_shape[temporal_axis] = 28
+    scratch = torch.empty(scratch_shape, dtype=torch.float32, device="cpu")
+    for start in range(0, video.shape[temporal_axis], 28):
+        length = min(28, video.shape[temporal_axis] - start)
+        chunk = scratch.narrow(temporal_axis, 0, length)
+        chunk.copy_(video.narrow(temporal_axis, start, length))
+        chunk.mul_(0.5).add_(0.5).clamp_(0, 1).mul_(255)
+        target = (
+            output[:, start : start + length]
+            if video.ndim == 5
+            else output[start : start + length]
+        )
+        # NumPy performs the same FP32-to-uint8 cast directly into final storage.
+        np.copyto(target, chunk.permute(permutation).numpy(), casting="unsafe")
+    return output
