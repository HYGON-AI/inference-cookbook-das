@@ -0,0 +1,93 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Output-only exact-order sink correction for preview inference.
+
+Compute each row scale once and broadcast over
+head_dim, preserving the existing BF16-before-sink boundary. Corrected LSE
+is not materialized because this inference caller does not return or use it.
+"""
+import torch
+import triton
+import triton.language as tl
+from inference.common.device import is_dcu
+from torch._inductor.runtime.triton_helpers import libdevice
+
+
+@triton.jit
+def hcu_preview_attn_sink_correct_kernel(
+    Output,
+    L,
+    S,
+    Y,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    OS: tl.constexpr,
+    OH: tl.constexpr,
+    LS: tl.constexpr,
+    LH: tl.constexpr,
+    BM: tl.constexpr,
+):
+    r = tl.program_id(0) * BM + tl.arange(0, BM)
+    t, h = r // H, r % H
+    row_lse = tl.load(L + h * LH + t * LS, mask=t < N, other=0.0)
+    sk = tl.load(S + h).to(tl.float32)
+    low = tl.minimum(row_lse, sk, propagate_nan=tl.PropagateNan.ALL)
+    high = tl.maximum(row_lse, sk, propagate_nan=tl.PropagateNan.ALL)
+    delta = tl.where((low == high) & (low == float("-inf")), float("-inf"), low - high)
+    corr = high + libdevice.log1p(libdevice.exp(delta))
+    wdiff = tl.where((row_lse == corr) & (row_lse == float("-inf")), float("-inf"), row_lse - corr)
+    w = libdevice.exp(wdiff)
+    d = tl.arange(0, D)
+    o = tl.load(
+        Output + t[:, None] * OS + h[:, None] * OH + d[None, :],
+        mask=t[:, None] < N,
+        other=0.0,
+    ).to(tl.float32)
+    y = o * w[:, None]
+    tl.store(Y + r[:, None] * D + d[None, :], y, mask=t[:, None] < N)
+
+
+def correct(out, lse, sink, sink_layout="sh"):
+    if not (
+        is_dcu()
+        and not torch.is_grad_enabled()
+        and out.is_cuda
+        and out.dtype == torch.bfloat16
+        and out.ndim == 3
+        and out.shape[1] in (1, 2, 3)
+        and out.shape[2] == 128
+        and out.shape[0] >= 16384
+        and out.stride(2) == 1
+        and lse.dtype == torch.float32
+        and lse.shape == (out.shape[1], out.shape[0])
+        and lse.device == out.device
+        and sink is not None
+        and sink_layout == "sh"
+        and sink.shape == (1, out.shape[1])
+        and sink.dtype == torch.float32
+        and sink.device == out.device
+        and sink.is_contiguous()
+    ):
+        return None
+    n, h, d = out.shape
+    y = torch.empty(out.shape, device=out.device, dtype=out.dtype)
+    # Match the original Inductor/libdevice compilation: disabling contraction
+    # changes transcendental rounding and fails the end-to-end precision gate.
+    hcu_preview_attn_sink_correct_kernel[(triton.cdiv(n * h, 16),)](
+        out,
+        lse,
+        sink,
+        y,
+        n,
+        h,
+        d,
+        out.stride(0),
+        out.stride(1),
+        lse.stride(1),
+        lse.stride(0),
+        BM=16,
+        num_warps=4,
+        enable_fp_fusion=True,
+    )
+    return y
diff --git a/inference/model/preview_mhc_flat.py b/inference/model/preview_mhc_flat.py
new file mode 100644
index 0000000..344eb28
--- /dev/null
+++ b/inference/model/preview_mhc_flat.py
@@ -0,0 +1,88 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Flat channel scheduling for four-stream, BF16 preview mHC mixing.
+
+Each output retains the original reduction tree (h-pre) or serial stream order
+(post). Products of BF16 inputs are accumulated in FP32; fusion is disabled.
+The existing opaque custom operators remain the compiler boundaries.
+
+
+X is contiguous BF16 [tokens, 4, channels]. H/P hold four mixing
+weights per token; R is [tokens, output stream, input stream]. H-pre returns
+[tokens, channels]. Post combines O [tokens, channels] with X and returns
+X's shape. Callers validate four streams and materialize contiguous inputs.
+"""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_preview_mhc_pre_mix_kernel(X, H, Y, N: tl.constexpr, C: tl.constexpr, B: tl.constexpr):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    t = i // C
+    c = i % C
+    m = i < N * C
+    r0 = tl.load(X + t * 4 * C + c, mask=m, other=0).to(tl.float32)
+    r1 = tl.load(X + t * 4 * C + C + c, mask=m, other=0).to(tl.float32)
+    r2 = tl.load(X + t * 4 * C + 2 * C + c, mask=m, other=0).to(tl.float32)
+    r3 = tl.load(X + t * 4 * C + 3 * C + c, mask=m, other=0).to(tl.float32)
+    h0 = tl.load(H + t * 4, mask=m, other=0).to(tl.float32)
+    h1 = tl.load(H + t * 4 + 1, mask=m, other=0).to(tl.float32)
+    h2 = tl.load(H + t * 4 + 2, mask=m, other=0).to(tl.float32)
+    h3 = tl.load(H + t * 4 + 3, mask=m, other=0).to(tl.float32)
+    v0 = r0 * h0
+    v1 = r1 * h1
+    v2 = r2 * h2
+    v3 = r3 * h3
+    y = (v0 + v2) + (v1 + v3)
+    tl.store(Y + i, y, mask=m)
+
+
+@triton.jit
+def hcu_preview_mhc_post_mix_kernel(
+    X, Output, P, R, Y, N: tl.constexpr, C: tl.constexpr, B: tl.constexpr
+):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    t = i // C
+    c = i % C
+    m = i < N * C
+    x0 = tl.load(X + t * 4 * C + c, mask=m, other=0).to(tl.float32)
+    x1 = tl.load(X + t * 4 * C + C + c, mask=m, other=0).to(tl.float32)
+    x2 = tl.load(X + t * 4 * C + 2 * C + c, mask=m, other=0).to(tl.float32)
+    x3 = tl.load(X + t * 4 * C + 3 * C + c, mask=m, other=0).to(tl.float32)
+    o = tl.load(Output + i, mask=m, other=0).to(tl.float32)
+    for j in tl.static_range(4):
+        r0 = tl.load(R + t * 16 + j * 4, mask=m, other=0).to(tl.float32)
+        r1 = tl.load(R + t * 16 + j * 4 + 1, mask=m, other=0).to(tl.float32)
+        r2 = tl.load(R + t * 16 + j * 4 + 2, mask=m, other=0).to(tl.float32)
+        r3 = tl.load(R + t * 16 + j * 4 + 3, mask=m, other=0).to(tl.float32)
+        p = tl.load(P + t * 4 + j, mask=m, other=0).to(tl.float32)
+        a = x0 * r0
+        a = a + x1 * r1
+        a = a + x2 * r2
+        a = a + x3 * r3
+        a = a + o * p
+        # Original post starts from +0; a zero accumulated result is therefore +0.
+        a = tl.where(a == 0.0, 0.0, a)
+        tl.store(Y + t * 4 * C + j * C + c, a, mask=m)
+
+
+def hpre(x, h):
+    n, _, c = x.shape
+    b = 512
+    y = torch.empty(n, c, device=x.device, dtype=x.dtype)
+    hcu_preview_mhc_pre_mix_kernel[(triton.cdiv(n * c, b),)](
+        x, h, y, n, c, b, num_warps=4, enable_fp_fusion=False
+    )
+    return y
+
+
+def post(x, o, p, r):
+    n, _, c = x.shape
+    b = 1024
+    y = torch.empty_like(x)
+    hcu_preview_mhc_post_mix_kernel[(triton.cdiv(n * c, b),)](
+        x, o, p, r, y, n, c, b, num_warps=4, enable_fp_fusion=False
+    )
+    return y
