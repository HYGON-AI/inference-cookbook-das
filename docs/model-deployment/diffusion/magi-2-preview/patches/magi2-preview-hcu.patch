@@ -0,0 +1,79 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Padded K/V storage for the supported HCU Preview FA layout.
+
+Padding is storage-only: no sequence, head, softmax, sink, or dtype changes.
+Every live K/V element is copied exactly; FA never reads the row gaps.
+
+
+K/V have [tokens, heads, 128] live elements, with one to three heads.
+Each output row has 32 unread padding elements after the live values. This
+module changes storage strides only; the FA caller chooses the backend.
+"""
+import torch
+import triton
+import triton.language as tl
+from inference.common.device import is_dcu
+
+
+@triton.jit
+def hcu_preview_fa_kv_padded_copy_kernel(
+    K,
+    V,
+    Output,
+    S: tl.constexpr,
+    KS: tl.constexpr,
+    VS: tl.constexpr,
+    WIDTH: tl.constexpr,
+    PADDED: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    row, col = i // WIDTH, i % WIDTH
+    kval = tl.load(K + row * KS + col, mask=row < S, other=0)
+    vval = tl.load(V + row * VS + col, mask=row < S, other=0)
+    tl.store(Output + row * PADDED + col, kval, mask=row < S)
+    tl.store(Output + (S + row) * PADDED + col, vval, mask=row < S)
+
+
+def allocate_kv_workspace(k):
+    """Allocate padding on the caller stream before launching auxiliary work."""
+    tokens, heads, head_dim = k.shape
+    return torch.empty((2, tokens, heads * head_dim + 32), device=k.device, dtype=k.dtype)
+
+
+def prepare_kv(k, v, *, workspace=None):
+    """Use padded storage for supported inference inputs; otherwise return K/V unchanged."""
+    if not (
+        is_dcu()
+        and not torch.is_grad_enabled()
+        and k.is_cuda
+        and v.device == k.device
+        and k.dtype == v.dtype == torch.bfloat16
+        and k.ndim == v.ndim == 3
+        and k.shape == v.shape
+        and k.shape[1] in (1, 2, 3)
+        and k.shape[2] == 128
+        and k.shape[0] >= 16384
+        and k.stride(1) == v.stride(1) == 128
+        and k.stride(2) == v.stride(2) == 1
+    ):
+        return k, v
+    sequence, heads, head_dim = k.shape
+    width = heads * head_dim
+    pitch = width + 32
+    storage = allocate_kv_workspace(k) if workspace is None else workspace
+    hcu_preview_fa_kv_padded_copy_kernel[(triton.cdiv(sequence * width, 1024),)](
+        k,
+        v,
+        storage,
+        sequence,
+        k.stride(0),
+        v.stride(0),
+        width,
+        pitch,
+        BLOCK=1024,
+        num_warps=4,
+    )
+    kv = storage[:, :, :width].view(2, sequence, heads, head_dim)
+    return kv[0], kv[1]
