+#!/usr/bin/env bash
+# Run the validated HCU inference path with per-module timing enabled.
+
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
+
+if ! command -v hy-smi >/dev/null 2>&1; then
+    echo "[demo] hy-smi was not found; use scripts/run_demo.sh on NVIDIA." >&2
+    exit 1
+fi
+
+RESOLUTION=${RESOLUTION:-1080p}
+OUTPUT_DIR=${OUTPUT_DIR:-output/demo_hcu_opt_vllm}
+SECONDS_PER_VIDEO=10
+SEED=${SEED:-42}
+GPUS=${GPUS:-8}
+SAMPLES=${SAMPLES:-assets/demo_samples_warmup.json}
+
+export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
+export MAGI2_CKPT_ROOT="${MAGI2_CKPT_ROOT:-/home/models/Magi-2}"
+export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
+
+# Validated component residency for 1080p on eight 64-GiB HCUs.
+export MAGI2_TEXT_ENC_OFFLOAD_MODE="${MAGI2_TEXT_ENC_OFFLOAD_MODE:-roundtrip}"
+export MAGI2_PREVIEW_OFFLOAD_MODE="${MAGI2_PREVIEW_OFFLOAD_MODE:-roundtrip}"
+export MAGI2_REFINER_OFFLOAD_MODE="${MAGI2_REFINER_OFFLOAD_MODE:-roundtrip}"
+export MAGI2_VAE_OFFLOAD_MODE="${MAGI2_VAE_OFFLOAD_MODE:-roundtrip}"
+export MAGI2_VAE_OUTPUT_OFFLOAD="${MAGI2_VAE_OUTPUT_OFFLOAD:-1}"
+export MAGI2_TURBO_VAE_CONV_T_CHUNK="${MAGI2_TURBO_VAE_CONV_T_CHUNK:-8}"
+
+echo "[demo] $(date +%T) resolution=$RESOLUTION, ${SECONDS_PER_VIDEO}s each, samples=$SAMPLES"
+
+exec torchrun --nnodes=1 --nproc_per_node="$GPUS" --rdzv-backend=c10d \
+    --rdzv-endpoint="localhost:${MASTER_PORT:-29500}" \
+    inference/pipeline/entry.py \
+    --resolution "$RESOLUTION" --seconds "$SECONDS_PER_VIDEO" --seed "$SEED" \
+    --samples "$SAMPLES" --output "$OUTPUT_DIR" --benchmark
