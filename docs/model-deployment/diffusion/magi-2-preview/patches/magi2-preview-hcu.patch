+++ b/inference/model/preview_mhc_post.py
@@ -0,0 +1,298 @@
+# Copyright (c) 2025-2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Exact-order TileLang kernel for preview mHC post mixing.
+
+The implementation is exposed through an opaque PyTorch custom op so graph
+compilation remains cacheable.  The preview model imports it lazily only for
+the HCU ``aiter_magi`` backend; CUDA and other backends retain their existing
+path.
+"""
+
+import math
+
+import torch
+
+from inference.common.device import is_dcu
+
+
+def _build_exact_post_kernel():
+    import tilelang
+    from tilelang import language as T
+
+    @tilelang.jit(
+        pass_configs={
+            tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+            tilelang.PassConfigKey.TL_PTXAS_REGISTER_USAGE_LEVEL: 10,
+            tilelang.PassConfigKey.TL_DISABLE_VECTORIZE_256: True,
+            tilelang.PassConfigKey.TL_ENABLE_AGGRESSIVE_SHARED_MEMORY_MERGE: True,
+        }
+    )
+    def exact_post_kernel(
+        num_stream: int,
+        hidden_size: int,
+        num_threads: int = 256,
+        hidden_block: int = 1024,
+    ) -> tilelang.JITKernel:
+        num_tokens = T.dynamic("num_tokens")
+        hidden_block = math.gcd(hidden_size, hidden_block)
+
+        @T.prim_func
+        def hcu_preview_mhc_post_mix_tilelang_kernel(
+            residual: T.Tensor[(num_tokens, num_stream, hidden_size), T.bfloat16],
+            layer_output: T.Tensor[(num_tokens, hidden_size), T.bfloat16],
+            post_mix: T.Tensor[(num_tokens, num_stream), T.bfloat16],
+            residual_mix: T.Tensor[(num_tokens, num_stream, num_stream), T.bfloat16],
+            output: T.Tensor[(num_tokens, num_stream, hidden_size), T.bfloat16],
+        ) -> None:
+            with T.Kernel(num_tokens, threads=num_threads) as token:
+                residual_local = T.alloc_fragment((num_stream, hidden_block), T.float32)
+                layer_output_local = T.alloc_fragment(hidden_block, T.float32)
+                output_local = T.alloc_fragment((num_stream, hidden_block), T.float32)
+                post_mix_local = T.alloc_fragment(num_stream, T.float32)
+                residual_mix_local = T.alloc_fragment((num_stream, num_stream), T.float32)
+
+                T.copy(post_mix[token, 0], post_mix_local)
+                T.copy(residual_mix[token, 0, 0], residual_mix_local)
+
+                for hidden_tile in T.Pipelined(T.ceildiv(hidden_size, hidden_block), num_stages=0):
+                    hidden_start = hidden_tile * hidden_block
+                    T.copy(
+                        residual[token, 0, hidden_start],
+                        residual_local,
+                        disable_tma=True,
+                    )
+                    T.copy(
+                        layer_output[token, hidden_start],
+                        layer_output_local,
+                        disable_tma=True,
+                    )
+                    T.clear(output_local)
+
+                    # Preserve MAGI's existing accumulation order exactly:
+                    # all residual streams first, then the post-layer term.
+                    for output_stream, hidden in T.Parallel(num_stream, hidden_block):
+                        for input_stream in T.serial(num_stream):
+                            output_local[output_stream, hidden] += (
+                                residual_mix_local[output_stream, input_stream]
+                                * residual_local[input_stream, hidden]
+                            )
+                        output_local[output_stream, hidden] += (
+                            post_mix_local[output_stream] * layer_output_local[hidden]
+                        )
+
+                    T.copy(
+                        output_local,
+                        output[token, 0, hidden_start],
+                        disable_tma=True,
+                        coalesced_width=8,
+                    )
+
+        return hcu_preview_mhc_post_mix_tilelang_kernel
+
+    return exact_post_kernel
+
+
+_EXACT_POST_KERNEL = None
+_EXACT_HPRE_KERNEL = None
+
+
+def _mhc_post_exact_impl(
+    residual: torch.Tensor,
+    layer_output: torch.Tensor,
+    post_mix: torch.Tensor,
+    residual_mix: torch.Tensor,
+) -> torch.Tensor:
+    """Run four-stream flat mixing, or the exact-order TileLang fallback."""
+    if not is_dcu():
+        raise RuntimeError("the HCU mHC post kernel requires HIP")
+    num_tokens, num_stream, hidden_size = residual.shape
+    expected = {
+        "layer_output": (num_tokens, hidden_size),
+        "post_mix": (num_tokens, num_stream),
+        "residual_mix": (num_tokens, num_stream, num_stream),
+    }
+    for name, tensor in (
+        ("layer_output", layer_output),
+        ("post_mix", post_mix),
+        ("residual_mix", residual_mix),
+    ):
+        if tuple(tensor.shape) != expected[name]:
+            raise ValueError(f"{name} must have shape {expected[name]}")
+    tensors = (residual, layer_output, post_mix, residual_mix)
+    if any(tensor.dtype != torch.bfloat16 for tensor in tensors):
+        raise TypeError("the HCU mHC post kernel requires BF16 tensors")
+    if any(not tensor.is_cuda for tensor in tensors):
+        raise ValueError("all mHC post tensors must be on a GPU")
+
+    if is_dcu() and num_stream == 4 and hidden_size == 3072:
+        from .preview_mhc_flat import post
+
+        return post(
+            residual.contiguous(),
+            layer_output.contiguous(),
+            post_mix.contiguous(),
+            residual_mix.contiguous(),
+        )
+    global _EXACT_POST_KERNEL
+    if _EXACT_POST_KERNEL is None:
+        _EXACT_POST_KERNEL = _build_exact_post_kernel()
+    output = torch.empty_like(residual)
+    kernel = _EXACT_POST_KERNEL(num_stream, hidden_size)
+    kernel(
+        residual.contiguous(),
+        layer_output.contiguous(),
+        post_mix.contiguous(),
+        residual_mix.contiguous(),
+        output,
+    )
+    return output
+
+
+@torch.library.custom_op("magi2::mhc_post_exact_tilelang", mutates_args=())
+def mhc_post_exact(
+    residual: torch.Tensor,
+    layer_output: torch.Tensor,
+    post_mix: torch.Tensor,
+    residual_mix: torch.Tensor,
+) -> torch.Tensor:
+    """Opaque compiler boundary for flat mixing and its TileLang fallback."""
+    return _mhc_post_exact_impl(residual, layer_output, post_mix, residual_mix)
+
+
+@mhc_post_exact.register_fake
+def _mhc_post_exact_fake(
+    residual: torch.Tensor,
+    layer_output: torch.Tensor,
+    post_mix: torch.Tensor,
+    residual_mix: torch.Tensor,
+) -> torch.Tensor:
+    del layer_output, post_mix, residual_mix
+    return torch.empty_like(residual)
+
+
+def _build_exact_hpre_kernel():
+    import tilelang
+    from tilelang import language as T
+
+    @tilelang.jit(
+        pass_configs={
+            tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+            tilelang.PassConfigKey.TL_PTXAS_REGISTER_USAGE_LEVEL: 10,
+            tilelang.PassConfigKey.TL_DISABLE_VECTORIZE_256: True,
+            tilelang.PassConfigKey.TL_ENABLE_AGGRESSIVE_SHARED_MEMORY_MERGE: True,
+        }
+    )
+    def exact_hpre_kernel(
+        num_stream: int,
+        hidden_size: int,
+        num_threads: int = 256,
+        hidden_block: int = 1024,
+    ) -> tilelang.JITKernel:
+        num_tokens = T.dynamic("num_tokens")
+        hidden_block = math.gcd(hidden_size, hidden_block)
+        values_per_thread = hidden_block // num_threads
+
+        @T.prim_func
+        def hcu_preview_mhc_pre_mix_tilelang_kernel(
+            residual: T.Tensor[(num_tokens, num_stream, hidden_size), T.bfloat16],
+            pre_mix: T.Tensor[(num_tokens, num_stream), T.bfloat16],
+            output: T.Tensor[(num_tokens, hidden_size), T.bfloat16],
+        ) -> None:
+            with T.Kernel(num_tokens, threads=num_threads) as token:
+                thread = T.get_thread_binding()
+                pre_mix_local = T.alloc_local((num_stream,), T.float32)
+                residual_local = T.alloc_local((num_stream * values_per_thread,), T.bfloat16)
+                output_local = T.alloc_local(values_per_thread, T.float32)
+                for stream in T.serial(num_stream):
+                    pre_mix_local[stream] = T.Cast(T.float32, pre_mix[token, stream])
+
+                for hidden_tile in T.serial(T.ceildiv(hidden_size, hidden_block)):
+                    hidden_start = hidden_tile * hidden_block
+                    for stream in T.serial(num_stream):
+                        local_start = stream * values_per_thread
+                        for value in T.vectorized(values_per_thread):
+                            residual_local[local_start + value] = residual[
+                                token,
+                                stream,
+                                hidden_start + thread * values_per_thread + value,
+                            ]
+
+                    for value in T.unroll(values_per_thread):
+                        v0 = pre_mix_local[0] * T.Cast(T.float32, residual_local[value])
+                        v1 = pre_mix_local[1] * T.Cast(
+                            T.float32,
+                            residual_local[values_per_thread + value],
+                        )
+                        v2 = pre_mix_local[2] * T.Cast(
+                            T.float32,
+                            residual_local[2 * values_per_thread + value],
+                        )
+                        v3 = pre_mix_local[3] * T.Cast(
+                            T.float32,
+                            residual_local[3 * values_per_thread + value],
+                        )
+                        # Match Triton's reduction layout for a four-value
+                        # leading axis: lanes 0/2 and 1/3 are paired first.
+                        output_local[value] = (v0 + v2) + (v1 + v3)
+                    for value in T.vectorized(values_per_thread):
+                        output[
+                            token,
+                            hidden_start + thread * values_per_thread + value,
+                        ] = output_local[value]
+
+        return hcu_preview_mhc_pre_mix_tilelang_kernel
+
+    return exact_hpre_kernel
+
+
+def _mhc_apply_hpre_exact_impl(
+    residual: torch.Tensor,
+    pre_mix: torch.Tensor,
+) -> torch.Tensor:
+    if not is_dcu():
+        raise RuntimeError("the exact mHC h-pre kernel requires HIP")
+    num_tokens, num_stream, hidden_size = residual.shape
+    if tuple(pre_mix.shape) != (num_tokens, num_stream):
+        raise ValueError("pre_mix has an incompatible shape")
+    if residual.dtype != torch.bfloat16 or pre_mix.dtype != torch.bfloat16:
+        raise TypeError("residual and pre_mix must be BF16")
+
+    if is_dcu() and num_stream == 4 and hidden_size == 3072:
+        from .preview_mhc_flat import hpre
+
+        return hpre(residual.contiguous(), pre_mix.contiguous())
+    global _EXACT_HPRE_KERNEL
+    if _EXACT_HPRE_KERNEL is None:
+        _EXACT_HPRE_KERNEL = _build_exact_hpre_kernel()
+    output = torch.empty((num_tokens, hidden_size), device=residual.device, dtype=residual.dtype)
+    kernel = _EXACT_HPRE_KERNEL(num_stream, hidden_size)
+    kernel(
+        residual.contiguous(),
+        pre_mix.contiguous(),
+        output,
+    )
+    return output
+
+
+@torch.library.custom_op("magi2::mhc_apply_hpre_exact_tilelang", mutates_args=())
+def mhc_apply_hpre_exact(
+    residual: torch.Tensor,
+    pre_mix: torch.Tensor,
+) -> torch.Tensor:
+    return _mhc_apply_hpre_exact_impl(residual, pre_mix)
+
+
+@mhc_apply_hpre_exact.register_fake
+def _mhc_apply_hpre_exact_fake(
+    residual: torch.Tensor,
+    pre_mix: torch.Tensor,
+) -> torch.Tensor:
+    del pre_mix
+    return torch.empty(
+        (residual.size(0), residual.size(2)),
+        device=residual.device,
+        dtype=residual.dtype,
+    )
+
+
+__all__ = ["mhc_apply_hpre_exact", "mhc_post_exact"]
