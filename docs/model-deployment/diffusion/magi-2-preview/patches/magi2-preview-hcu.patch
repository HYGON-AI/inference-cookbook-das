@@ -0,0 +1,56 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Reuse model-side static preview layout without caching any noisy activation."""
+import torch
+from inference.infra.distributed import psm
+
+
+def cached_model_layout(model, source_coords, source_modal, coords, modality, splits):
+    from .magi2_preview import Modality, ModalityDispatcher
+
+    # Keep the source tensors alive in the single cache entry: address reuse
+    # must never make a different sample look like a hit. Include mutation and
+    # Fourier-weight versions, device relocation and CP group identity.
+    rope_tensors = list(model.pre_adapter.rope.parameters()) + list(
+        model.pre_adapter.rope.buffers()
+    )
+    # Inference tensors have no mutation version, even if subsequently used
+    # outside inference_mode. Recompute their layout instead of caching it.
+    cacheable = not any(t.is_inference() for t in [source_coords, source_modal, *rope_tensors])
+    weights = (
+        tuple((p.data_ptr(), p._version, p.device, p.dtype) for p in rope_tensors)
+        if cacheable
+        else ()
+    )
+    rope_config = tuple(
+        getattr(model.pre_adapter.rope, k, None)
+        for k in ("dim", "in_pixels", "temperature", "max_res", "linear_bands")
+    )
+    key = (
+        id(source_coords),
+        source_coords._version if cacheable else None,
+        id(source_modal),
+        source_modal._version if cacheable else None,
+        coords.device,
+        torch.cuda.current_stream(coords.device).cuda_stream,
+        tuple(splits),
+        id(psm.get_parallel_group("cp")),
+        weights,
+        rope_config,
+    )
+    cached = getattr(model, "_preview_model_layout", None)
+    if cacheable and cached is not None and cached[0] == key:
+        return cached[3]
+    time_mask = modality == Modality.TIME
+    modality = modality.clone()
+    modality[time_mask] = Modality.TEXT
+    dispatcher = ModalityDispatcher(modality, 3)
+    indices = tuple(
+        (modality == m).nonzero().flatten() for m in (Modality.VIDEO, Modality.AUDIO, Modality.TEXT)
+    ) + (time_mask.nonzero().flatten(),)
+    split_tensor = torch.tensor(splits, device=coords.device, dtype=torch.long)
+    rope = model.pre_adapter.rope(coords)
+    result = (split_tensor, dispatcher, *indices, rope)
+    if cacheable:
+        model._preview_model_layout = (key, source_coords, source_modal, result)
+    return result
diff --git a/inference/model/preview_qkv_pack.py b/inference/model/preview_qkv_pack.py
