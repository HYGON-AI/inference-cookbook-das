index 0000000..8eee451
--- /dev/null
+++ b/inference/model/preview_fa_schedule.py
@@ -0,0 +1,75 @@
+"""Reuse one Preview FA stream with input-ready gating on verified HCU layouts.
+
+The CP path submits FA1 before waiting for input preparation on the host. This
+avoids a pending auxiliary GPU barrier interfering with earlier caller work.
+The historical FA_AUTOTUNE disable switch still selects serial attention.
+"""
+
+import os
+from dataclasses import dataclass
+
+import torch
+import torch.distributed as dist
+
+from inference.common.device import is_dcu
+from inference.infra.distributed import psm
+from inference.model import preview_cp_overlap as cp
+
+
+@dataclass
+class _Plan:
+    key: tuple
+    stream: torch.cuda.Stream
+
+
+def _key(model, inputs):
+    x, coords, _, varlen, *_ = inputs
+    if not (
+        is_dcu()
+        and not torch.is_grad_enabled()
+        and not model.training
+        and x.is_cuda
+        and dist.is_initialized()
+        and dist.get_world_size() == 8
+        and psm.get_world_size("cp") == psm.get_world_size("ep") == 8
+        and model.config.num_layers == 40
+        and model.config.num_heads_q == 24
+        and coords.shape[0] == 8 * 15126
+        and varlen.max_seqlen_q == varlen.max_seqlen_k
+        and varlen.max_seqlen_q >= 16384
+        and os.environ.get("MAGI2_HCU_DISABLE_PREVIEW_CP_OVERLAP", "0") != "1"
+        and os.environ.get("MAGI2_HCU_DISABLE_PREVIEW_FA_AUTOTUNE", "0") != "1"
+        and not torch.cuda.is_current_stream_capturing()
+    ):
+        return None
+    return (
+        x.device,
+        x.dtype,
+        tuple(x.shape),
+        varlen.max_seqlen_q,
+        varlen.cu_seqlens_q.numel(),
+        torch.cuda.current_stream(x.device).cuda_stream,
+    )
+
+
+def _invoke(model, inputs, stream):
+    token = cp._attention_stream.set(stream)
+    try:
+        # Only the verified HCU layout may move modality FC1 across the EP return.
+        if stream is not None:
+            return model(*inputs, hcu_return_overlap=True)
+        return model(*inputs)
+    finally:
+        cp._attention_stream.reset(token)
+
+
+def forward(model, inputs):
+    """Run once, retaining one auxiliary stream for the supported caller/layout."""
+    key = _key(model, inputs)
+    if key is None:
+        return _invoke(model, inputs, None)
+    plan = getattr(model, "_hcu_preview_fa_plan", None)
+    if plan is None or plan.key != key:
+        plan = _Plan(key, torch.cuda.Stream(device=inputs[0].device, priority=-1))
+        model._hcu_preview_fa_plan = plan
+    return _invoke(model, inputs, plan.stream)
