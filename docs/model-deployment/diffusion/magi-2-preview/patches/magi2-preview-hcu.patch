+++ b/inference/pipeline/timing.py
@@ -0,0 +1,323 @@
+"""Low-overhead module and denoising timing for offline inference."""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Iterator
+
+import numpy as np
+import torch
+import torch.distributed as dist
+
+
+class PerformanceTracker:
+    def __init__(self) -> None:
+        self.enabled = False
+        # The first N real denoising steps are reported as warmup; no extra
+        # model execution is performed for benchmarking.
+        self.preview_warmup_steps = 0
+        self.refiner_warmup_steps = 0
+        self._totals: dict[str, float] = {}
+        self._active: set[str] = set()
+        self._starts: dict[str, float] = {}
+        # Preserve invocation boundaries so warmup can be classified for every
+        # sample instead of only once at the beginning of a batch.
+        self._step_runs: dict[str, list[list[float]]] = {}
+
+    def configure(
+        self,
+        enabled: bool,
+        preview_warmup_steps: int = 5,
+        refiner_warmup_steps: int = 1,
+    ) -> None:
+        self.enabled = enabled
+        self.preview_warmup_steps = max(0, preview_warmup_steps)
+        self.refiner_warmup_steps = max(0, refiner_warmup_steps)
+        self.reset()
+
+    def reset(self) -> None:
+        """Clear measurements while preserving the benchmark configuration."""
+        self._totals = {
+            name: 0.0
+            for name in (
+                "pipeline_init", "prompt_enhancement", "text_encoder",
+                "image_encoder", "preview_warmup", "preview_diffusion",
+                "refiner_warmup", "refiner_diffusion", "vae_decode",
+                "audio_decode", "output_resize", "video_encode", "audio_mux",
+                "benchmark_e2e", "actual_run_e2e",
+            )
+        }
+        self._starts.clear()
+        self._step_runs.clear()
+        self._active.clear()
+
+    @staticmethod
+    def _sync_cuda() -> None:
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+
+    def start(self, name: str, gpu: bool = True) -> None:
+        if not self.enabled:
+            return
+        if gpu:
+            self._sync_cuda()
+        self._active.add(name)
+        self._starts[name] = time.perf_counter()
+
+    def stop(self, name: str, gpu: bool = True) -> None:
+        if not self.enabled:
+            return
+        if gpu:
+            self._sync_cuda()
+        started = self._starts.pop(name)
+        self.add(name, time.perf_counter() - started)
+
+    @contextmanager
+    def measure(self, name: str, gpu: bool = True) -> Iterator[None]:
+        if not self.enabled:
+            yield
+            return
+        self.start(name, gpu=gpu)
+        try:
+            yield
+        finally:
+            self.stop(name, gpu=gpu)
+
+    def add(self, name: str, seconds: float) -> None:
+        if self.enabled:
+            self._active.add(name)
+            self._totals[name] = self._totals.get(name, 0.0) + seconds
+
+    def add_steps(self, name: str, milliseconds: list[float]) -> None:
+        if self.enabled:
+            self._step_runs.setdefault(name, []).append(milliseconds)
+
+    def new_step_event(self):
+        if not self.enabled or not torch.cuda.is_available():
+            return None
+        return torch.cuda.Event(enable_timing=True)
+
+    def finish_step_events(self, name: str, events: list[tuple]) -> None:
+        if not self.enabled or not events:
+            return
+        self._sync_cuda()
+        self.add_steps(name, [start.elapsed_time(end) for start, end in events])
+
+    @staticmethod
+    def _distributed_max(values: list[float]) -> list[float]:
+        if not values or not dist.is_initialized() or dist.get_world_size() == 1:
+            return values
+        device = torch.cuda.current_device() if torch.cuda.is_available() else "cpu"
+        tensor = torch.tensor(values, dtype=torch.float64, device=device)
+        dist.all_reduce(tensor, op=dist.ReduceOp.MAX)
+        return tensor.cpu().tolist()
+
+    @staticmethod
+    def _step_summary(values: list[float]) -> dict[str, float | int]:
+        if not values:
+            return {
+                "steps": 0,
+                "total_s": 0.0,
+                "avg_s": 0.0,
+                "p50_s": 0.0,
+                "p90_s": 0.0,
+                "first_s": 0.0,
+            }
+        array = np.asarray(values, dtype=np.float64)
+        return {
+            "steps": int(array.size),
+            "total_s": float(array.sum() / 1000.0),
+            "avg_s": float(array.mean() / 1000.0),
+            "p50_s": float(np.percentile(array, 50) / 1000.0),
+            "p90_s": float(np.percentile(array, 90) / 1000.0),
+            "first_s": float(array[0] / 1000.0),
+        }
+
+    def report(self, output_dir: str, filename: str = "performance.json") -> None:
+        if not self.enabled:
+            return
+        names = sorted(self._totals)
+        totals = self._distributed_max([self._totals[name] for name in names])
+        active = self._distributed_max([float(name in self._active) for name in names])
+        active_names = {name for name, value in zip(names, active) if value}
+        summary: dict[str, object] = {
+            name: (float(value) if name in active_names else None)
+            for name, value in zip(names, totals)
+        }
+
+        for name, local_runs in self._step_runs.items():
+            step_runs = [self._distributed_max(run) for run in local_runs]
+            step_values = [value for run in step_runs for value in run]
+            warmup_count = (
+                self.preview_warmup_steps
+                if name == "preview_diffusion"
+                else self.refiner_warmup_steps
+                if name == "refiner_diffusion"
+                else 0
+            )
+            warmup_values = [
+                value for run in step_runs for value in run[:warmup_count]
+            ]
+            steady_values = [
+                value for run in step_runs for value in run[warmup_count:]
+            ]
+            summary[f"{name}_device_steps"] = self._step_summary(step_values)
+            summary[f"{name}_warmup_steps"] = self._step_summary(warmup_values)
+            summary[f"{name}_steady_steps"] = self._step_summary(steady_values)
+            # Per-step timings are part of the benchmark result. They are
+            # required to distinguish first-step compilation from steady state.
+            summary[f"{name}_device_step_seconds"] = [value / 1000.0 for value in step_values]
+            if warmup_values:
+                summary[f"{name}_warmup"] = {
+                    "enabled": True,
+                    "steps": len(warmup_values),
+                    "duration_s": float(sum(warmup_values) / 1000.0),
+                    "step_seconds": [value / 1000.0 for value in warmup_values],
+                }
+            else:
+                summary[f"{name}_warmup"] = {
+                    "enabled": False,
+                    "steps": 0,
+                    "duration_s": 0.0,
+                    "step_seconds": [],
+                }
+            summary[f"{name}_steady"] = {
+                "steps": len(steady_values),
+                "duration_s": float(sum(steady_values) / 1000.0),
+                "step_seconds": [value / 1000.0 for value in steady_values],
+            }
+            if name == "preview_diffusion":
+                summary["preview_warmup"] = float(sum(warmup_values) / 1000.0)
+                summary["preview_warmup_steps"] = self._step_summary(warmup_values)
+                active_names.add("preview_warmup")
+            elif name == "refiner_diffusion":
+                summary["refiner_warmup"] = float(sum(warmup_values) / 1000.0)
+                summary["refiner_warmup_steps"] = self._step_summary(warmup_values)
+                active_names.add("refiner_warmup")
+
+        rank = dist.get_rank() if dist.is_initialized() else 0
+        if rank != 0:
+            return
+        Path(output_dir).mkdir(parents=True, exist_ok=True)
+        output_path = Path(output_dir) / filename
+        output_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")
+        print("[MAGI2 PERF]")
+        ordered = [
+            "pipeline_init", "prompt_enhancement", "text_encoder", "image_encoder",
+            "preview_warmup", "preview_diffusion", "refiner_warmup",
+            "refiner_diffusion", "vae_decode", "audio_decode", "output_resize",
+            "video_encode", "audio_mux", "benchmark_e2e", "actual_run_e2e",
+        ]
+        for name in ordered:
+            if name not in active_names:
+                continue
+            suffix = " (first real steps)" if name.endswith("warmup") else ""
+            step = summary.get(f"{name}_device_steps")
+            step_text = ""
+            if isinstance(step, dict):
+                step_text = (
+                    f"  steps={step['steps']} avg={step['avg_s']:.3f}s "
+                    f"p50={step['p50_s']:.3f}s p90={step['p90_s']:.3f}s "
+                    f"first={step['first_s']:.3f}s"
+                )
+            print(f"{name:<22} {float(summary[name]):9.3f}s{suffix}{step_text}")
+        print(f"performance_json       {output_path}")
+
+
+def torch_profiler_enabled(stage: str) -> bool:
+    """Return whether this stage should be profiled in the current process."""
+    if os.getenv("TORCH_PROF", "0") != "1":
+        return False
+
+    stage = stage.strip().lower()
+    valid_stages = {"preview", "refiner"}
+    if stage not in valid_stages:
+        raise ValueError(
+            f"unknown profiler stage {stage!r}; expected one of {sorted(valid_stages)}"
+        )
+
+    selected_stage = os.getenv("TORCH_PROF_STAGE", "all").strip().lower()
+    valid_selections = valid_stages | {"all"}
+    if selected_stage not in valid_selections:
+        raise ValueError(
+            f"invalid TORCH_PROF_STAGE={selected_stage!r}; "
+            f"expected one of {sorted(valid_selections)}"
+        )
+    if selected_stage not in ("all", stage):
+        return False
+
+    rank = dist.get_rank() if dist.is_initialized() else 0
+    return rank == 0
+
+
+def single_step_profiler_schedule(profile_step: int, use_warmup: bool = True):
+    """Return a profiler schedule whose only active step is one-indexed."""
+    if profile_step < 1:
+        raise ValueError("profile_step must be at least 1")
+    if not use_warmup:
+        active_step = profile_step - 1
+
+        def schedule(step: int):
+            if step == active_step:
+                return torch.profiler.ProfilerAction.RECORD_AND_SAVE
+            return torch.profiler.ProfilerAction.NONE
+
+        return schedule
+
+    return torch.profiler.schedule(
+        wait=0,
+        warmup=profile_step - 1,
+        active=1,
+        repeat=1,
+    )
+
+
+def create_torch_profiler(
+    trace_filename: str,
+    profile_step: int,
+    *,
+    use_warmup: bool = True,
+    with_stack: bool = True,
+    print_summary: bool = True,
+):
+    """Create the shared preview/refiner profiler configuration."""
+    trace_dir = Path(os.getenv("TORCH_PROF_DIR", "output/profiler"))
+    trace_dir.mkdir(parents=True, exist_ok=True)
+    rank = dist.get_rank() if dist.is_initialized() else 0
+    if rank != 0:
+        raise RuntimeError("Torch Profiler may only be created on global rank 0")
+    trace_path = trace_dir / trace_filename.format(rank=rank)
+
+    print(
+        "[magi2 profiler] "
+        f"rank={rank} profile_step={profile_step} "
+        f"warmup={use_warmup} with_stack={with_stack} "
+        f"trace={trace_path}",
+        flush=True,
+    )
+
+    def trace_handler(profiler) -> None:
+        if print_summary:
+            print(profiler.key_averages().table(sort_by="self_cuda_time_total"))
+        profiler.export_chrome_trace(str(trace_path))
+        print(f"[magi2 profiler] trace exported: {trace_path}", flush=True)
+
+    return torch.profiler.profile(
+        activities=[
+            torch.profiler.ProfilerActivity.CPU,
+            torch.profiler.ProfilerActivity.CUDA,
+        ],
+        schedule=single_step_profiler_schedule(
+            profile_step,
+            use_warmup=use_warmup,
+        ),
+        on_trace_ready=trace_handler,
+        with_stack=with_stack,
+    )
+
+
+perf = PerformanceTracker()
