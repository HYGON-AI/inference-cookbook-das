index 0000000..de0b680
--- /dev/null
+++ b/inference/model/preview_qkv_pack.py
@@ -0,0 +1,347 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Fused Preview Q/K RMSNorm, RoPE, BF16 cast, reorder and CP packing."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+from torch.library import triton_op, wrap_triton
+
+from inference.common.device import is_dcu
+
+
+def _effective_heads(num_heads: int, cp_size: int) -> tuple[int, int, int]:
+    """Return effective heads, heads per CP rank and repeat factor."""
+    if num_heads >= cp_size:
+        if num_heads % cp_size != 0:
+            raise ValueError(f"num_heads={num_heads} must be divisible by cp_size={cp_size}")
+        return num_heads, num_heads // cp_size, 1
+    if cp_size % num_heads != 0:
+        raise ValueError(f"cp_size={cp_size} must be divisible by num_heads={num_heads}")
+    return cp_size, 1, cp_size // num_heads
+
+
+@triton.jit
+def hcu_preview_qkv_norm_rope_cp_pack_kernel(
+    q_ptr,
+    k_ptr,
+    v_ptr,
+    q_weight_ptr,
+    k_weight_ptr,
+    rope_ptr,
+    inv_permute_ptr,
+    cu_group_sizes_ptr,
+    out_ptr,
+    eps,
+    q_stride_t,
+    q_stride_h,
+    q_stride_d,
+    k_stride_t,
+    k_stride_h,
+    k_stride_d,
+    v_stride_t,
+    v_stride_h,
+    v_stride_d,
+    rope_stride_t,
+    rope_stride_d,
+    out_stride_t,
+    out_stride_h,
+    out_stride_d,
+    T: tl.constexpr,
+    Q_HEADS: tl.constexpr,
+    K_HEADS: tl.constexpr,
+    V_HEADS: tl.constexpr,
+    CP_SIZE: tl.constexpr,
+    Q_EFFECTIVE_HEADS: tl.constexpr,
+    K_EFFECTIVE_HEADS: tl.constexpr,
+    V_EFFECTIVE_HEADS: tl.constexpr,
+    Q_LOCAL_HEADS: tl.constexpr,
+    K_LOCAL_HEADS: tl.constexpr,
+    V_LOCAL_HEADS: tl.constexpr,
+    Q_REPEAT: tl.constexpr,
+    K_REPEAT: tl.constexpr,
+    V_REPEAT: tl.constexpr,
+    NUM_GROUPS: tl.constexpr,
+    Q_WEIGHT_GROUPS: tl.constexpr,
+    K_WEIGHT_GROUPS: tl.constexpr,
+    HEAD_DIM: tl.constexpr,
+    ROTARY_DIM: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    GROUP_START: tl.constexpr = 0,
+    GROUP_HEADS: tl.constexpr = 0,
+):
+    token = tl.program_id(0)
+    effective_head = tl.program_id(1)
+    if GROUP_HEADS:
+        effective_head = (
+            effective_head // GROUP_HEADS * 3 + GROUP_START + effective_head % GROUP_HEADS
+        )
+    d = tl.arange(0, BLOCK_D)
+    d_mask = d < HEAD_DIM
+    rotary_half = ROTARY_DIM // 2
+    is_rotary = d < ROTARY_DIM
+    rope_d = d % rotary_half
+    rotary_partner_d = tl.where(d < rotary_half, d + rotary_half, d - rotary_half)
+    partner_d = tl.where(is_rotary, rotary_partner_d, d)
+    rotate_sign = tl.where(d < rotary_half, -1.0, 1.0)
+
+    source_token = tl.load(inv_permute_ptr + token)
+    group = tl.zeros([], dtype=tl.int32)
+    for group_boundary in tl.static_range(1, NUM_GROUPS):
+        group_end = tl.load(cu_group_sizes_ptr + group_boundary)
+        group += source_token >= group_end
+
+    sin = tl.load(
+        rope_ptr + token * rope_stride_t + rope_d * rope_stride_d,
+        mask=d_mask & is_rotary,
+        other=0.0,
+    ).to(tl.float32)
+    cos = tl.load(
+        rope_ptr + token * rope_stride_t + (rotary_half + rope_d) * rope_stride_d,
+        mask=d_mask & is_rotary,
+        other=0.0,
+    ).to(tl.float32)
+
+    if effective_head < Q_EFFECTIVE_HEADS:
+        if Q_WEIGHT_GROUPS == 1:
+            q_weight_group = 0
+        else:
+            q_weight_group = group
+        q_source_head = effective_head // Q_REPEAT
+        q_ptrs = q_ptr + source_token * q_stride_t + q_source_head * q_stride_h + d * q_stride_d
+        q_partner_ptrs = (
+            q_ptr + source_token * q_stride_t + q_source_head * q_stride_h + partner_d * q_stride_d
+        )
+        q = tl.load(q_ptrs, mask=d_mask, other=0.0).to(tl.float32)
+        q_partner = tl.load(q_partner_ptrs, mask=d_mask, other=0.0).to(tl.float32)
+        q_inv_rms = tl.rsqrt(tl.sum(q * q, axis=0) / HEAD_DIM + eps)
+        q_weight = tl.load(
+            q_weight_ptr + q_weight_group * HEAD_DIM + d,
+            mask=d_mask,
+            other=0.0,
+        ).to(tl.float32)
+        q_partner_weight = tl.load(
+            q_weight_ptr + q_weight_group * HEAD_DIM + partner_d,
+            mask=d_mask,
+            other=0.0,
+        ).to(tl.float32)
+        q_norm = q * q_inv_rms * (q_weight + 1.0)
+        q_partner_norm = q_partner * q_inv_rms * (q_partner_weight + 1.0)
+        q_rope = tl.where(
+            is_rotary,
+            q_norm * cos + rotate_sign * q_partner_norm * sin,
+            q_norm,
+        )
+
+        q_cp_rank = effective_head // Q_LOCAL_HEADS
+        q_local_head = effective_head % Q_LOCAL_HEADS
+        if GROUP_HEADS:
+            q_local_head -= GROUP_START
+        q_out_ptrs = (
+            out_ptr
+            + (q_cp_rank * T + token) * out_stride_t
+            + q_local_head * out_stride_h
+            + d * out_stride_d
+        )
+        tl.store(q_out_ptrs, q_rope, mask=d_mask)
+
+    if effective_head < K_EFFECTIVE_HEADS:
+        if K_WEIGHT_GROUPS == 1:
+            k_weight_group = 0
+        else:
+            k_weight_group = group
+        k_source_head = effective_head // K_REPEAT
+        k_ptrs = k_ptr + source_token * k_stride_t + k_source_head * k_stride_h + d * k_stride_d
+        k_partner_ptrs = (
+            k_ptr + source_token * k_stride_t + k_source_head * k_stride_h + partner_d * k_stride_d
+        )
+        k = tl.load(k_ptrs, mask=d_mask, other=0.0).to(tl.float32)
+        k_partner = tl.load(k_partner_ptrs, mask=d_mask, other=0.0).to(tl.float32)
+        k_inv_rms = tl.rsqrt(tl.sum(k * k, axis=0) / HEAD_DIM + eps)
+        k_weight = tl.load(
+            k_weight_ptr + k_weight_group * HEAD_DIM + d,
+            mask=d_mask,
+            other=0.0,
+        ).to(tl.float32)
+        k_partner_weight = tl.load(
+            k_weight_ptr + k_weight_group * HEAD_DIM + partner_d,
+            mask=d_mask,
+            other=0.0,
+        ).to(tl.float32)
+        k_norm = k * k_inv_rms * (k_weight + 1.0)
+        k_partner_norm = k_partner * k_inv_rms * (k_partner_weight + 1.0)
+        k_rope = tl.where(
+            is_rotary,
+            k_norm * cos + rotate_sign * k_partner_norm * sin,
+            k_norm,
+        )
+
+        k_cp_rank = effective_head // K_LOCAL_HEADS
+        k_local_head = effective_head % K_LOCAL_HEADS
+        if GROUP_HEADS:
+            k_local_head -= GROUP_START
+        k_out_ptrs = (
+            out_ptr
+            + (k_cp_rank * T + token) * out_stride_t
+            + ((GROUP_HEADS if GROUP_HEADS else Q_LOCAL_HEADS) + k_local_head) * out_stride_h
+            + d * out_stride_d
+        )
+        tl.store(k_out_ptrs, k_rope, mask=d_mask)
+
+    if effective_head < V_EFFECTIVE_HEADS:
+        v_source_head = effective_head // V_REPEAT
+        v = tl.load(
+            v_ptr + source_token * v_stride_t + v_source_head * v_stride_h + d * v_stride_d,
+            mask=d_mask,
+            other=0.0,
+        )
+        v_cp_rank = effective_head // V_LOCAL_HEADS
+        v_local_head = effective_head % V_LOCAL_HEADS
+        if GROUP_HEADS:
+            v_local_head -= GROUP_START
+        v_out_ptrs = (
+            out_ptr
+            + (v_cp_rank * T + token) * out_stride_t
+            + ((2 * GROUP_HEADS if GROUP_HEADS else Q_LOCAL_HEADS + K_LOCAL_HEADS) + v_local_head)
+            * out_stride_h
+            + d * out_stride_d
+        )
+        tl.store(v_out_ptrs, v, mask=d_mask)
+
+
+@triton_op("magi2::preview_qkv_norm_rope_cp_pack", mutates_args={})
+def preview_qkv_norm_rope_cp_pack(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_weight: torch.Tensor,
+    k_weight: torch.Tensor,
+    rope: torch.Tensor,
+    inv_permute_mapping: torch.Tensor,
+    cu_group_sizes: torch.Tensor,
+    cp_size: int,
+    eps: float,
+    group_start: int = 0,
+    group_heads: int = 0,
+) -> torch.Tensor:
+    """Produce the exact fused-input layout consumed by CP all-to-all.
+
+    Inputs use modality-grouped token order. The output is BF16 with layout
+    ``[cp * token, q_local_head + k_local_head + v_local_head, head_dim]``.
+    """
+    if not (q.ndim == k.ndim == v.ndim == 3):
+        raise ValueError("q, k and v must have [token, head, head_dim] shape")
+    if q.shape[0] != k.shape[0] or q.shape[0] != v.shape[0]:
+        raise ValueError("q, k and v token counts must match")
+    if q.shape[2] != k.shape[2] or q.shape[2] != v.shape[2]:
+        raise ValueError("q, k and v head dimensions must match")
+    if rope.ndim != 2 or rope.shape[0] != q.shape[0]:
+        raise ValueError(f"rope must have shape [token, rotary_dim], got {tuple(rope.shape)}")
+    if rope.shape[1] <= 0 or rope.shape[1] > q.shape[2] or rope.shape[1] % 2 != 0:
+        raise ValueError(
+            f"rotary_dim must be positive, even and <= head_dim={q.shape[2]}; "
+            f"got {rope.shape[1]}"
+        )
+
+    num_groups = cu_group_sizes.numel() - 1
+    if q_weight.numel() % q.shape[2] != 0 or k_weight.numel() % k.shape[2] != 0:
+        raise ValueError("Q/K norm weight sizes must be multiples of head_dim")
+    q_weight_groups = q_weight.numel() // q.shape[2]
+    k_weight_groups = k_weight.numel() // k.shape[2]
+    if q_weight_groups not in (1, num_groups) or k_weight_groups not in (
+        1,
+        num_groups,
+    ):
+        raise ValueError(
+            "Q/K norm weights must contain either one shared group or one group "
+            f"per modality ({num_groups}); got q={q_weight_groups}, "
+            f"k={k_weight_groups}"
+        )
+
+    q_effective, q_local, q_repeat = _effective_heads(q.shape[1], cp_size)
+    k_effective, k_local, k_repeat = _effective_heads(k.shape[1], cp_size)
+    v_effective, v_local, v_repeat = _effective_heads(v.shape[1], cp_size)
+    total_local_heads = q_local + k_local + v_local
+    if group_heads:
+        if not (
+            (q_local, k_local, v_local, cp_size) == (3, 3, 3, 8)
+            and 0 <= group_start < 3
+            and 1 <= group_heads <= 3 - group_start
+        ):
+            raise ValueError("Head-group CP packing requires a valid span of CP8's three heads")
+        total_local_heads = 3 * group_heads
+    out = torch.empty(
+        (cp_size * q.shape[0], total_local_heads, q.shape[2]),
+        device=q.device,
+        dtype=torch.bfloat16,
+    )
+    block_d = triton.next_power_of_2(q.shape[2])
+    grid = (
+        q.shape[0],
+        cp_size * group_heads if group_heads else max(q_effective, k_effective, v_effective),
+    )
+    launch_options = {"num_warps": 1}
+    if is_dcu():
+        launch_options["waves_per_eu"] = 1
+    wrap_triton(hcu_preview_qkv_norm_rope_cp_pack_kernel)[grid](
+        q,
+        k,
+        v,
+        q_weight,
+        k_weight,
+        rope,
+        inv_permute_mapping,
+        cu_group_sizes,
+        out,
+        eps,
+        q.stride(0),
+        q.stride(1),
+        q.stride(2),
+        k.stride(0),
+        k.stride(1),
+        k.stride(2),
+        v.stride(0),
+        v.stride(1),
+        v.stride(2),
+        rope.stride(0),
+        rope.stride(1),
+        out.stride(0),
+        out.stride(1),
+        out.stride(2),
+        T=q.shape[0],
+        Q_HEADS=q.shape[1],
+        K_HEADS=k.shape[1],
+        V_HEADS=v.shape[1],
+        CP_SIZE=cp_size,
+        Q_EFFECTIVE_HEADS=q_effective,
+        K_EFFECTIVE_HEADS=k_effective,
+        V_EFFECTIVE_HEADS=v_effective,
+        Q_LOCAL_HEADS=q_local,
+        K_LOCAL_HEADS=k_local,
+        V_LOCAL_HEADS=v_local,
+        Q_REPEAT=q_repeat,
+        K_REPEAT=k_repeat,
+        V_REPEAT=v_repeat,
+        NUM_GROUPS=num_groups,
+        Q_WEIGHT_GROUPS=q_weight_groups,
+        K_WEIGHT_GROUPS=k_weight_groups,
+        HEAD_DIM=q.shape[2],
+        ROTARY_DIM=rope.shape[1],
+        BLOCK_D=block_d,
+        GROUP_START=group_start,
+        GROUP_HEADS=group_heads,
+        **launch_options,
+    )
+    return out
+
+
+def preview_qkv_local_head_splits(
+    q_heads: int, k_heads: int, v_heads: int, cp_size: int
+) -> tuple[int, int, int]:
+    return (
+        _effective_heads(q_heads, cp_size)[1],
+        _effective_heads(k_heads, cp_size)[1],
+        _effective_heads(v_heads, cp_size)[1],
+    )
