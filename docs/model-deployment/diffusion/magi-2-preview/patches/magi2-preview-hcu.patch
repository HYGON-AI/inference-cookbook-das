index 0000000..0bc6dd7
--- /dev/null
+++ b/inference/model/preview_shared_prefix.py
@@ -0,0 +1,76 @@
+"""Cover EP dispatch with shared FC1 and EP return with video FC1 on HCU."""
+
+import torch
+import torch.distributed as dist
+import torch.nn.functional as F
+
+from inference.model.preview_ep_pack import preview_ep_dispatch_pack
+from inference.model.preview_ep_token_helper import token_helper_forward
+from inference.model.preview_ep_unpadded import undispatch_unpadded
+
+_calls = 0
+
+
+def call_counts():
+    # The retained implementation always overlaps supported calls.
+    return _calls, _calls
+
+
+def run(module, x, norm, weight, group, modality_weight=None, modality_sizes=None):
+    """Execute the guarded EP8/12-head path on the original compute stream."""
+    modality_prefix = None
+    project_modality = None
+    modality_outputs = []
+    if modality_weight is not None:
+        assert len(modality_sizes) == 3
+        grouped_weight = modality_weight.view(3, -1, norm.shape[1])
+        modality_inputs = torch.split(norm, modality_sizes, dim=0)
+
+        def project_modality():
+            # Preserve video GEMM dimensions and BF16 output; defer audio/text.
+            modality_outputs.append(F.linear(modality_inputs[0], grouped_weight[0]))
+
+    # Check the dynamic dimension inside the opaque operation. Specializing it
+    # in the captured model conflicts with its existing mark_dynamic contract.
+    if norm.shape[0] != 15126:
+        # The caller selects the three-output operation only for the verified
+        # layout; all other layouts keep modality FC1 in the original graph.
+        assert project_modality is None, "return overlap requires the verified token layout"
+        return module._forward_impl(x, True), F.linear(norm, weight)
+
+    global _calls
+    _calls += 1
+    tokens = x.shape[0]
+    heads = 2 if dist.get_rank(group) < 6 else 0
+    packed = preview_ep_dispatch_pack(x.view(tokens, 12, 256), 6).reshape(-1)
+    received = torch.empty((8 * tokens * heads * 256,), device=x.device, dtype=x.dtype)
+    work = dist.all_to_all_single(
+        received,
+        packed,
+        output_split_sizes=[tokens * heads * 256] * 8,
+        input_split_sizes=[tokens * 2 * 256] * 6 + [0, 0],
+        group=group,
+        async_op=True,
+    )
+    # Keep exactly the original GEMM dimensions, dtype and BF16 output. All
+    # following activation/FC2/addmm operations remain in the surrounding graph.
+    prefix = F.linear(norm, weight)
+    work.wait()
+    x_heads = received.view(8 * tokens, heads, 256)
+    if module._preview_ep_token_helper:
+        out = token_helper_forward(
+            module, x_heads, group, direct_return=True, after_return_submit=project_modality
+        )
+    else:
+        if module.has_real_moe_heads:
+            probabilities, indices = module._route(x_heads)
+            out = module._flash_forward(x_heads, probabilities, indices)
+        else:
+            out = torch.empty_like(x_heads)
+        out = undispatch_unpadded(out, group, after_submit=project_modality)
+    if project_modality is None:
+        return out.reshape(tokens, 3072), prefix
+    for i in (1, 2):
+        modality_outputs.append(F.linear(modality_inputs[i], grouped_weight[i]))
+    modality_prefix = torch.cat(modality_outputs, dim=0)
+    return out.reshape(tokens, 3072), prefix, modality_prefix
