index 0000000..d0d8627
--- /dev/null
+++ b/inference/model/preview_ep_pack.py
@@ -0,0 +1,196 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Fused Preview expert-parallel padding and layout packing."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+from torch.library import triton_op, wrap_triton
+
+from inference.common.device import is_dcu
+
+
+@triton.jit
+def hcu_preview_ep_dispatch_pack_kernel(
+    input_ptr,
+    output_ptr,
+    input_stride_s,
+    input_stride_h,
+    input_stride_d,
+    output_stride_ep,
+    output_stride_s,
+    output_stride_h,
+    output_stride_d,
+    sequence,
+    input_heads: tl.constexpr,
+    local_heads: tl.constexpr,
+    head_dim: tl.constexpr,
+    block_s: tl.constexpr,
+    block_d: tl.constexpr,
+):
+    token = tl.program_id(0) * block_s + tl.arange(0, block_s)
+    padded_head = tl.program_id(1)
+    d = tl.arange(0, block_d)
+    token_mask = token < sequence
+    value_mask = token_mask[:, None] & (d[None, :] < head_dim)
+    values = tl.load(
+        input_ptr
+        + token[:, None] * input_stride_s
+        + padded_head * input_stride_h
+        + d[None, :] * input_stride_d,
+        mask=value_mask & (padded_head < input_heads),
+        other=0.0,
+    )
+
+    ep_rank = padded_head // local_heads
+    local_head = padded_head - ep_rank * local_heads
+    tl.store(
+        output_ptr
+        + ep_rank * output_stride_ep
+        + token[:, None] * output_stride_s
+        + local_head * output_stride_h
+        + d[None, :] * output_stride_d,
+        values,
+        mask=value_mask,
+    )
+
+
+@triton_op("magi2::preview_ep_dispatch_pack", mutates_args={})
+def preview_ep_dispatch_pack(input: torch.Tensor, ep_size: int) -> torch.Tensor:
+    """Pack ``[S,H,D]`` to ``[EP,S,ceil(H/EP),D]`` while zero-padding H."""
+    if input.ndim != 3:
+        raise ValueError("EP dispatch input must have shape [sequence, head, dim]")
+    if ep_size <= 0:
+        raise ValueError("EP size must be positive")
+    if not input.is_cuda:
+        raise ValueError("fused EP dispatch packing requires an HCU tensor")
+
+    sequence, input_heads, head_dim = input.shape
+    padded_heads = triton.cdiv(input_heads, ep_size) * ep_size
+    local_heads = padded_heads // ep_size
+    output = torch.empty(
+        (ep_size, sequence, local_heads, head_dim),
+        device=input.device,
+        dtype=input.dtype,
+    )
+    block_s = 4
+    block_d = triton.next_power_of_2(head_dim)
+    launch_options = {"num_warps": 4}
+    if is_dcu():
+        launch_options["waves_per_eu"] = 1
+    wrap_triton(hcu_preview_ep_dispatch_pack_kernel)[
+        (triton.cdiv(sequence, block_s), padded_heads)
+    ](
+        input,
+        output,
+        input.stride(0),
+        input.stride(1),
+        input.stride(2),
+        output.stride(0),
+        output.stride(1),
+        output.stride(2),
+        output.stride(3),
+        sequence,
+        input_heads=input_heads,
+        local_heads=local_heads,
+        head_dim=head_dim,
+        block_s=block_s,
+        block_d=block_d,
+        **launch_options,
+    )
+    return output
+
+
+@triton.jit
+def hcu_preview_ep_undispatch_unpack_kernel(
+    input_ptr,
+    output_ptr,
+    input_stride_ep,
+    input_stride_s,
+    input_stride_h,
+    input_stride_d,
+    output_stride_s,
+    output_stride_h,
+    output_stride_d,
+    sequence,
+    local_heads: tl.constexpr,
+    output_heads: tl.constexpr,
+    head_dim: tl.constexpr,
+    block_s: tl.constexpr,
+    block_d: tl.constexpr,
+):
+    token = tl.program_id(0) * block_s + tl.arange(0, block_s)
+    output_head = tl.program_id(1)
+    d = tl.arange(0, block_d)
+    mask = (token[:, None] < sequence) & (d[None, :] < head_dim)
+    ep_rank = output_head // local_heads
+    local_head = output_head - ep_rank * local_heads
+    values = tl.load(
+        input_ptr
+        + ep_rank * input_stride_ep
+        + token[:, None] * input_stride_s
+        + local_head * input_stride_h
+        + d[None, :] * input_stride_d,
+        mask=mask,
+        other=0.0,
+    )
+    tl.store(
+        output_ptr
+        + token[:, None] * output_stride_s
+        + output_head * output_stride_h
+        + d[None, :] * output_stride_d,
+        values,
+        mask=mask,
+    )
+
+
+@triton_op("magi2::preview_ep_undispatch_unpack", mutates_args={})
+def preview_ep_undispatch_unpack(
+    input: torch.Tensor,
+    output_heads: int,
+) -> torch.Tensor:
+    """Unpack ``[EP,S,Hlocal,D]`` directly to unpadded ``[S,H,D]``."""
+    if input.ndim != 4:
+        raise ValueError("EP undispatch input must have shape [EP, sequence, head, dim]")
+    if output_heads <= 0 or output_heads > input.shape[0] * input.shape[2]:
+        raise ValueError("requested EP output head count is invalid")
+    if not input.is_cuda:
+        raise ValueError("fused EP undispatch packing requires an HCU tensor")
+
+    _, sequence, local_heads, head_dim = input.shape
+    output = torch.empty(
+        (sequence, output_heads, head_dim),
+        device=input.device,
+        dtype=input.dtype,
+    )
+    block_s = 4
+    block_d = triton.next_power_of_2(head_dim)
+    launch_options = {"num_warps": 4}
+    if is_dcu():
+        launch_options["waves_per_eu"] = 1
+    wrap_triton(hcu_preview_ep_undispatch_unpack_kernel)[
+        (triton.cdiv(sequence, block_s), output_heads)
+    ](
+        input,
+        output,
+        input.stride(0),
+        input.stride(1),
+        input.stride(2),
+        input.stride(3),
+        output.stride(0),
+        output.stride(1),
+        output.stride(2),
+        sequence,
+        local_heads=local_heads,
+        output_heads=output_heads,
+        head_dim=head_dim,
+        block_s=block_s,
+        block_d=block_d,
+        **launch_options,
+    )
+    return output
+
+
+__all__ = ["preview_ep_dispatch_pack", "preview_ep_undispatch_unpack"]
diff --git a/inference/model/preview_ep_token_helper.py b/inference/model/preview_ep_token_helper.py
new file mode 100644
index 0000000..588ab94
--- /dev/null
+++ b/inference/model/preview_ep_token_helper.py
@@ -0,0 +1,175 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""CP8/EP8 token sharing with exact owner-side routing.
+
+Owners 0..5 retain both original heads and route their full sequence unchanged.
+Helpers 6/7 hold heads (1,3,5)/(7,9,11), respectively. Each computes the second
+half of its three heads' tokens, including the complete, ordered top-k reduce.
+Only final BF16 vectors return to owners; no partial FP sums cross ranks.
+This is a load-time layout used in layers 4..35. The four skipped layers
+omit unused dummy expert weights, giving a net +11.25 GiB per helper.
+"""
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+from inference.flash_mh_moe.triton.route_csr import (
+    _route_exclusive_scan_kernel,
+    flash_mh_moe_direct_csr,
+)
+from inference.flash_mh_moe.triton.mh_moe_two_stage import mh_moe_fwd_two_stage
+
+
+@triton.jit
+def hcu_preview_moe_owner_route_histogram_kernel(
+    Indices, Counts, S: tl.constexpr, K: tl.constexpr, BLOCK: tl.constexpr
+):
+    r = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    h = r // (S * K)
+    t = (r // K) % S
+    mask = (r < 2 * S * K) & ((h == 0) | (t < S // 2))
+    e = tl.load(Indices + r, mask=mask, other=0).to(tl.int32) + h * 256
+    tl.atomic_add(Counts + e, 1, mask=mask)
+
+
+@triton.jit
+def hcu_preview_moe_owner_route_scatter_kernel(
+    P,
+    Indices,
+    Cursor,
+    Gather,
+    Prob,
+    Route,
+    S: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    r = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    h = r // (S * K)
+    t = (r // K) % S
+    mask = (r < 2 * S * K) & ((h == 0) | (t < S // 2))
+    e = tl.load(Indices + r, mask=mask, other=0).to(tl.int32) + h * 256
+    dest = tl.atomic_add(Cursor + e, 1, mask=mask)
+    p = tl.load(P + r, mask=mask, other=0.0)
+    tl.store(Gather + dest, t, mask=mask)
+    tl.store(Prob + dest, p, mask=mask)
+    tl.store(Route + dest, r, mask=mask)
+
+
+def owner_csr(probs, indices):
+    h, s, k = probs.shape
+    assert h == 2 and k == 6 and indices.shape == probs.shape
+    probs, indices = probs.contiguous(), indices.contiguous()
+    count = (s + s // 2) * k
+    counts = torch.zeros(512, device=indices.device, dtype=torch.int32)
+    offsets = torch.empty(513, device=indices.device, dtype=torch.int32)
+    cursors = torch.empty_like(counts)
+    gather = torch.empty(count, device=indices.device, dtype=torch.int32)
+    sorted_probs = torch.empty(count, device=indices.device, dtype=torch.float32)
+    routes = torch.empty_like(gather)
+    grid = (triton.cdiv(2 * s * k, 256),)
+    hcu_preview_moe_owner_route_histogram_kernel[grid](
+        indices, counts, s, k, BLOCK=256, num_warps=4
+    )
+    _route_exclusive_scan_kernel[(1,)](counts, offsets, cursors, 512, BLOCK_E=512, num_warps=4)
+    hcu_preview_moe_owner_route_scatter_kernel[grid](
+        probs,
+        indices,
+        cursors,
+        gather,
+        sorted_probs,
+        routes,
+        s,
+        k,
+        BLOCK=256,
+        num_warps=4,
+    )
+    return gather, sorted_probs, offsets, routes
+
+
+def _exchange(payload, n, width, rank, group, reverse=False):
+    """Static counts: no device-to-host count reads, dropped routes or capacity limits."""
+    send, recv = [0] * 8, [0] * 8
+    if rank < 6:
+        send[6 + rank // 3] = n * width
+    else:
+        for owner in range((rank - 6) * 3, (rank - 5) * 3):
+            recv[owner] = n * width
+    if reverse:
+        send, recv = recv, send
+    received = torch.empty(sum(recv), dtype=payload.dtype, device=payload.device)
+    dist.all_to_all_single(
+        received,
+        payload.reshape(-1),
+        output_split_sizes=recv,
+        input_split_sizes=send,
+        group=group,
+    )
+    return received
+
+
+def token_helper_forward(module, x, group, *, direct_return=False, after_return_submit=None):
+    """Compute complete top-k outputs after the original unpadded EP dispatch.
+
+    Normally return the original owner layout. The guarded direct-return caller
+    instead receives ``[local_tokens, 12, 256]`` on every original token rank.
+    """
+    assert direct_return or after_return_submit is None
+    rank = dist.get_rank(group)
+    s, _, d = x.shape
+    assert dist.get_world_size(group) == 8 and d == 256
+    cut, n = s // 2, s - s // 2
+    if rank < 6:
+        probs, indices = module._route(x)
+        sx = x[cut:, 1, :].contiguous()
+        sp = probs[1, cut:, :].contiguous()
+        si = indices[1, cut:, :].to(torch.int32).contiguous()
+    else:
+        sx = torch.empty(0, device=x.device, dtype=x.dtype)
+        sp = torch.empty(0, device=x.device, dtype=torch.float32)
+        si = torch.empty(0, device=x.device, dtype=torch.int32)
+    rx = _exchange(sx, n, d, rank, group)
+    rp = _exchange(sp, n, 6, rank, group)
+    ri = _exchange(si, n, 6, rank, group)
+    if rank < 6:
+        g, p, offsets, routes = owner_csr(probs, indices)
+        out = mh_moe_fwd_two_stage(
+            x,
+            g,
+            p,
+            offsets,
+            module.W_gate,
+            module.W_up,
+            module.W_down,
+            routes,
+            True,
+            route_capacity=2 * s * 6,
+        )
+        send_out = torch.empty(0, device=x.device, dtype=x.dtype)
+    else:
+        hx = rx.view(3, n, d).permute(1, 0, 2).contiguous()
+        g, p, offsets, routes = flash_mh_moe_direct_csr(rp.view(3, n, 6), ri.view(3, n, 6), 256)
+        hout = mh_moe_fwd_two_stage(
+            hx,
+            g,
+            p,
+            offsets,
+            module.W_gate,
+            module.W_up,
+            module.W_down,
+            routes,
+            True,
+            chunk_tile_limit=2048,
+        )
+        send_out = None if direct_return else hout.permute(1, 0, 2).contiguous()
+        out = torch.empty_like(x)
+    if direct_return:
+        from .preview_ep_direct_return import return_to_token_ranks
+
+        return return_to_token_ranks(
+            out if rank < 6 else hout, group, after_submit=after_return_submit
+        )
+    returned = _exchange(send_out, n, d, rank, group, reverse=True)
+    if rank < 6:
+        out[cut:, 1, :].copy_(returned.view(n, d))
+    return out
