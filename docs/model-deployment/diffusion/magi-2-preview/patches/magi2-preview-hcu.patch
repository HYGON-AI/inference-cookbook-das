new file mode 100644
index 0000000..61b391c
--- /dev/null
+++ b/inference/model/refiner_fa2_sparse.py
@@ -0,0 +1,240 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Exact HCU FA2 sparse attention for the refiner's block-local layout.
+
+This backend does not prune attention scores.  It converts the refiner's
+existing block-local mask into FA2 block offsets, reads K/V directly from their
+original storage, and leaves short (<64-token) K fragments on the existing
+varlen FA2 plus FP32-LSE merge path.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+from inference.common.device import is_dcu
+
+from inference.model.refiner_fa2_plan import (
+    Fa2SparsePlan,
+    _run_residual_partition,
+)
+
+
+_SPARSE_BLOCK_SIZE = 64
+_SPARSE_MAX_QUERY_TOKENS = 2048
+
+# Plans are already cached for the lifetime of a data-proxy layout. Keying by
+# the block-table tensor keeps that storage alive, prevents allocator pointer
+# reuse from aliasing a stale entry, and shares the one-time head expansion
+# across every refiner layer without adding a dict field that Magi custom-op
+# schemas reject.
+_SPARSE_METADATA_CACHE: dict[
+    tuple[torch.Tensor, int], tuple["Fa2SparseGroup", ...]
+] = {}
+
+
+@dataclass(frozen=True)
+class Fa2SparseGroup:
+    """One batch of consecutive, equal-length logical query blocks."""
+
+    token_start: int
+    token_end: int
+    query_length: int
+    block_count: torch.Tensor
+    block_offset: torch.Tensor
+    column_count: torch.Tensor
+    column_index: torch.Tensor
+
+
+@torch.no_grad()
+def _build_sparse_groups(
+    plan: Fa2SparsePlan, query_heads: int
+) -> tuple[Fa2SparseGroup, ...]:
+    """Expand static block metadata once for the post-CP query-head count."""
+
+    if query_heads <= 0:
+        raise ValueError("sparse attention requires at least one query head")
+    cache_key = (plan.video_block_table, query_heads)
+    cached = _SPARSE_METADATA_CACHE.get(cache_key)
+    if cached is not None:
+        return cached  # type: ignore[return-value]
+
+    cu_q = plan.video_cu_seqlens_q
+    query_lengths = cu_q[1:].to(torch.int64) - cu_q[:-1].to(torch.int64)
+    if query_lengths.numel() == 0:
+        raise ValueError("sparse attention requires at least one video block")
+    if bool(torch.any(query_lengths <= 0).item()):
+        raise ValueError("sparse query blocks must be non-empty")
+    if bool(torch.any(query_lengths > _SPARSE_MAX_QUERY_TOKENS).item()):
+        raise ValueError(
+            "the installed HCU sparse FA2 kernel supports at most "
+            f"{_SPARSE_MAX_QUERY_TOKENS} query tokens per sequence"
+        )
+
+    page_starts = plan.page_token_indices[:, 0].to(torch.int32)
+    block_offsets = page_starts[plan.video_block_table.to(torch.int64)]
+    block_counts = torch.div(
+        plan.video_seqused_k, _SPARSE_BLOCK_SIZE, rounding_mode="floor"
+    ).to(torch.int32)
+
+    # A regular sparse call has one sequence length for the whole batch. Split
+    # only where the logical refiner block length changes. At 1080p this yields
+    # 3570x128 and 510x112, so Q remains a view and needs no padding/copy.
+    changes = torch.nonzero(
+        query_lengths[1:] != query_lengths[:-1], as_tuple=False
+    ).flatten()
+    splits = [0]
+    splits.extend(int(index.item()) + 1 for index in changes)
+    splits.append(int(query_lengths.numel()))
+
+    groups: list[Fa2SparseGroup] = []
+    width = int(block_offsets.shape[1])
+    for block_start, block_end in zip(splits, splits[1:]):
+        query_length = int(query_lengths[block_start].item())
+        query_rows = (query_length + _SPARSE_BLOCK_SIZE - 1) // _SPARSE_BLOCK_SIZE
+        batch_size = block_end - block_start
+        counts = (
+            block_counts[block_start:block_end]
+            .view(batch_size, 1, 1)
+            .expand(-1, query_heads, query_rows)
+            .contiguous()
+        )
+        offsets = (
+            block_offsets[block_start:block_end]
+            .view(batch_size, 1, 1, width)
+            .expand(-1, query_heads, query_rows, -1)
+            .contiguous()
+        )
+        # The kernel ignores PyTorch metadata strides. Keep every tensor
+        # physically compact; sliced/expanded metadata silently produces wrong
+        # results for heads after head zero.
+        column_counts = torch.zeros_like(counts)
+        column_indices = torch.zeros(
+            (batch_size, query_heads, query_rows, 1),
+            device=counts.device,
+            dtype=torch.int32,
+        )
+        groups.append(
+            Fa2SparseGroup(
+                token_start=int(cu_q[block_start].item()),
+                token_end=int(cu_q[block_end].item()),
+                query_length=query_length,
+                block_count=counts,
+                block_offset=offsets,
+                column_count=column_counts,
+                column_index=column_indices,
+            )
+        )
+
+    result = tuple(groups)
+    _SPARSE_METADATA_CACHE[cache_key] = result
+    return result
+
+
+@torch.no_grad()
+def run_fa2_sparse_attention(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    plan: Fa2SparsePlan,
+    optimization_layer: int = -1,
+    tail_is_text_only: bool = False,
+    video_ready=None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Run exact sparse-full-page plus residual attention.
+
+    The returned LSE covers video queries. Tail queries use one direct dense
+    FA2 call and do not need LSE because no split result is merged there.
+    """
+
+    from flash_attn.flash_attn_interface import flash_attn_func, sparse_attn_func
+
+    if not plan.enabled:
+        raise ValueError("cannot run sparse attention with a disabled FA2 plan")
+    if query.ndim != 3 or key.ndim != 3 or value.ndim != 3:
+        raise ValueError("sparse attention expects Q/K/V shaped [tokens, heads, dim]")
+    if key.shape != value.shape:
+        raise ValueError("key and value must have identical shapes")
+    if query.shape[0] != plan.total_token_num or key.shape[0] != plan.total_token_num:
+        raise ValueError("Q/K/V token count does not match the FA2 plan")
+    if query.shape[2] != key.shape[2] or query.shape[1] % key.shape[1] != 0:
+        raise ValueError("invalid GQA head layout")
+    if query.stride(-1) != 1 or key.stride(-1) != 1 or value.stride(-1) != 1:
+        raise ValueError("sparse attention requires a contiguous head dimension")
+
+    query_heads = int(query.shape[1])
+    groups = _build_sparse_groups(plan, query_heads)
+    output = torch.empty_like(query)
+    video_lse = torch.empty(
+        (plan.video_token_num, query_heads), device=query.device, dtype=torch.float32
+    )
+
+    key_batched = key.unsqueeze(0)
+    value_batched = value.unsqueeze(0)
+    for group in groups:
+        token_count = group.token_end - group.token_start
+        batch_size = int(group.block_count.shape[0])
+        expected_tokens = batch_size * group.query_length
+        if token_count != expected_tokens:
+            raise ValueError("sparse query group is not a dense equal-length partition")
+        query_group = query[group.token_start : group.token_end].view(
+            batch_size, group.query_length, query_heads, query.shape[2]
+        )
+        output_group = output[group.token_start : group.token_end].view_as(query_group)
+        group_output, group_lse = sparse_attn_func(
+            query_group,
+            key_batched.expand(batch_size, -1, -1, -1),
+            value_batched.expand(batch_size, -1, -1, -1),
+            group.block_count,
+            group.block_offset,
+            group.column_count,
+            group.column_index,
+            return_softmax_lse=True,
+            out=output_group,
+            enable_dynamic_skip=False,
+        )
+        if group_output.data_ptr() != output_group.data_ptr():
+            output_group.copy_(group_output)
+        video_lse[group.token_start : group.token_end].copy_(
+            group_lse.permute(0, 2, 1).reshape(token_count, query_heads)
+        )
+
+    _run_residual_partition(
+        query=query[: plan.video_token_num],
+        key=key,
+        value=value,
+        cu_q=plan.video_cu_seqlens_q,
+        residual_indices=plan.video_residual_token_indices,
+        residual_cu_k=plan.video_residual_cu_seqlens_k,
+        residual_batches=plan.video_residual_batches,
+        output=output[: plan.video_token_num],
+        output_lse=video_lse,
+    )
+
+    if video_ready is not None:
+        video_ready(output[: plan.video_token_num])
+
+    if plan.video_token_num < plan.total_token_num:
+        tail_query = query[plan.video_token_num :].unsqueeze(0)
+        tail_output = output[plan.video_token_num :].unsqueeze(0)
+        # The caller marks only layer 29 of the 30-layer model, with no audio
+        # and no later consumer of text outputs. All text K/V were consumed above.
+        if is_dcu() and optimization_layer == 29 and tail_is_text_only:
+            tail_output.zero_()
+            return output, video_lse
+        tail_output.copy_(flash_attn_func(tail_query, key_batched, value_batched))
+
+    return output, video_lse
diff --git a/inference/model/refiner_gather.py b/inference/model/refiner_gather.py
new file mode 100644
index 0000000..a5d6f4d
--- /dev/null
+++ b/inference/model/refiner_gather.py
@@ -0,0 +1,76 @@
+"""Copy the two BF16 residual tensors in one kernel, with unchanged index order.
+
+K/V are BF16 [source tokens, 1, 128] with independent row strides.
+IDX is a contiguous list of plan-owned token indices; negative indices
+retain PyTorch's wrap-from-end convention. KO/VO are contiguous outputs in
+the original index order. The validated plan, not this copy kernel, owns
+index bounds. Inputs remain alive until the caller-stream copy is ordered.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_refiner_residual_kv_gather_kernel(
+    K,
+    V,
+    IDX,
+    KO,
+    VO,
+    N: tl.constexpr,
+    ROWS: tl.constexpr,
+    WIDTH: tl.constexpr,
+    KS: tl.constexpr,
+    VS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = i < N * WIDTH
+    row = tl.load(IDX + i // WIDTH, mask, 0)
+    row = tl.where(row < 0, row + ROWS, row)
+    source_k = row * KS + i % WIDTH
+    source_v = row * VS + i % WIDTH
+    k = tl.load(K + source_k, mask, 0)
+    v = tl.load(V + source_v, mask, 0)
+    tl.store(KO + i, k, mask)
+    tl.store(VO + i, v, mask)
+
+
+def gather_pair(key, value, indices):
+    """Internal helper: indices come from the validated Fa2SparsePlan."""
+    if not (
+        key.is_cuda
+        and key.dtype == value.dtype == torch.bfloat16
+        and (key.shape == value.shape)
+        and (key.ndim == 3)
+        and (key.shape[1:] == (1, 128))
+        and (key.stride(-1) == value.stride(-1) == 1)
+        and (key.stride(0) >= 128)
+        and (value.stride(0) >= 128)
+        and indices.is_contiguous()
+        and (indices.ndim == 1)
+        and (indices.dtype in (torch.int32, torch.int64))
+        and (key.device == value.device == indices.device)
+    ):
+        return None
+    shape = (indices.numel(), *key.shape[1:])
+    ko = torch.empty(shape, device=key.device, dtype=key.dtype)
+    vo = torch.empty_like(ko)
+    if indices.numel():
+        hcu_refiner_residual_kv_gather_kernel[triton.cdiv(ko.numel(), 4096),](
+            key.view(torch.int16),
+            value.view(torch.int16),
+            indices,
+            ko.view(torch.int16),
+            vo.view(torch.int16),
+            indices.numel(),
+            key.shape[0],
+            128,
+            key.stride(0),
+            value.stride(0),
+            4096,
+            num_warps=4,
+        )
+    return (ko, vo)
diff --git a/inference/model/refiner_merge.py b/inference/model/refiner_merge.py
new file mode 100644
index 0000000..f16ae0a
--- /dev/null
+++ b/inference/model/refiner_merge.py
@@ -0,0 +1,99 @@
+"""Exact vector epilogue for the original partitioned attention merge.
+
+Weights and merged LSE are computed by the original ATen operations. This
+kernel keeps the two FP32 products, FP32 addition and final BF16 rounding.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_refiner_attn_partition_merge_kernel(
+    P,
+    R,
+    PW,
+    RW,
+    LSE,
+    Output,
+    OLSE,
+    N: tl.constexpr,
+    HEADS: tl.constexpr,
+    DIM: tl.constexpr,
+    PW0: tl.constexpr,
+    PW1: tl.constexpr,
+    RW0: tl.constexpr,
+    RW1: tl.constexpr,
+    L0: tl.constexpr,
+    L1: tl.constexpr,
+    OL0: tl.constexpr,
+    OL1: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = i < N
+    row = i // (HEADS * DIM)
+    head = (i // DIM) % HEADS
+    p = tl.load(P + i, mask, 0).to(tl.float32)
+    r = tl.load(R + i, mask, 0).to(tl.float32)
+    pw = tl.load(PW + row * PW0 + head * PW1, mask, 0)
+    rw = tl.load(RW + row * RW0 + head * RW1, mask, 0)
+    a = p * pw
+    b = r * rw
+    v = a + b
+    y = v.to(tl.bfloat16)
+    y = tl.where(v != v, tl.full((), 0x7FC0, tl.uint16).to(tl.bfloat16, bitcast=True), y)
+    tl.store(Output + i, y, mask)
+    first = mask & (i % DIM == 0)
+    lse = tl.load(LSE + row * L0 + head * L1, first, 0)
+    tl.store(OLSE + row * OL0 + head * OL1, lse, first)
+
+
+def supports_vector_merge(page, residual, output, output_lse):
+    arrays = (page, residual, output)
+    if not all(
+        x.is_cuda and x.dtype == torch.bfloat16 and x.ndim == 3 and x.is_contiguous()
+        for x in arrays
+    ):
+        return False
+    if any(x.device != page.device for x in (*arrays, output_lse)):
+        return False
+    if output_lse.dtype != torch.float32 or not output_lse.is_cuda or output_lse.ndim != 2:
+        return False
+    for x in (page, residual):
+        if (
+            x.untyped_storage().data_ptr() == output.untyped_storage().data_ptr()
+            and x.data_ptr() != output.data_ptr()
+        ):
+            return False
+    return True
+
+
+def merge_vectors(page, residual, page_weight, residual_weight, merged_lse, output, output_lse):
+    if not page.numel():
+        return
+    block = 4096
+    hcu_refiner_attn_partition_merge_kernel[(triton.cdiv(page.numel(), block),)](
+        page,
+        residual,
+        page_weight,
+        residual_weight,
+        merged_lse,
+        output,
+        output_lse,
+        page.numel(),
+        page.shape[1],
+        page.shape[2],
+        page_weight.stride(0),
+        page_weight.stride(1),
+        residual_weight.stride(0),
+        residual_weight.stride(1),
+        merged_lse.stride(0),
+        merged_lse.stride(1),
+        output_lse.stride(0),
+        output_lse.stride(1),
+        block,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
diff --git a/inference/model/refiner_mlp_norm.py b/inference/model/refiner_mlp_norm.py
new file mode 100644
index 0000000..399a35c
--- /dev/null
+++ b/inference/model/refiner_mlp_norm.py
@@ -0,0 +1,57 @@
+"""gfx936 MLP norm epilogue; ATen owns the original reduction.
+
+Keep both FP32 multiplications separate and canonicalize BF16 NaNs as ATen does.
+The caller must pass supports_mlp before dispatch; no residual input is modified.
+
+
+X is FP32 [tokens, 4096], R is [tokens, 1], and W is [4096]. All
+are contiguous. O is a newly allocated BF16 [tokens, 4096] tensor. The
+caller supplies the same-device ATen reciprocal standard deviation.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_refiner_mlp_norm_epilogue_kernel(X, R, W, Output, N: tl.constexpr, B: tl.constexpr):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    mask = i < N * 4096
+    x = tl.load(X + i, mask, 0)
+    r = tl.load(R + i // 4096, mask, 0)
+    w = tl.load(W + i % 4096, mask, 0)
+    scale = w + 1.0
+    t = x * r
+    t = t * scale
+    y = t.to(tl.bfloat16)
+    y = tl.where(t != t, tl.full((), 0x7FC0, tl.uint16).to(tl.bfloat16, bitcast=True), y)
+    tl.store(Output + i, y, mask)
+
+
+def mlp_norm(x, rstd, weight, block=1024):
+    assert x.ndim == 2 and x.shape[1] == 4096 and x.is_contiguous() and x.dtype == torch.float32
+    assert rstd.shape == (x.shape[0], 1) and rstd.is_contiguous() and rstd.dtype == torch.float32
+    assert weight.shape == (4096,) and weight.dtype == torch.float32 and weight.is_contiguous()
+    output = torch.empty_like(x, dtype=torch.bfloat16)
+    hcu_refiner_mlp_norm_epilogue_kernel[(triton.cdiv(x.numel(), block),)](
+        x, rstd, weight, output, x.shape[0], block, num_warps=4, enable_fp_fusion=False
+    )
+    return output
+
+
+def supports_mlp(x, weight):
+    return (
+        not torch.is_grad_enabled()
+        and torch.version.hip is not None
+        and x.is_cuda
+        and weight.device == x.device
+        and x.dtype == weight.dtype == torch.float32
+        and x.ndim == 2
+        and x.shape[1] == 4096
+        and x.is_contiguous()
+        and weight.ndim == 1
+        and weight.numel() % 4096 == 0
+        and weight.is_contiguous()
+        and torch.cuda.get_device_properties(x.device).gcnArchName.split(":")[0] == "gfx936"
+    )
diff --git a/inference/model/refiner_norm_rope.py b/inference/model/refiner_norm_rope.py
new file mode 100644
index 0000000..8768bdc
--- /dev/null
+++ b/inference/model/refiner_norm_rope.py
@@ -0,0 +1,131 @@
+"""Exact HCU Q/K epilogue with the original RoPE contraction order.
+
+Inputs X and R are contiguous FP32 [tokens, heads, 128] and
+[tokens, heads, 1]; W is FP32 [modalities, 128]. M selects W's modality
+per token. P is [tokens, rotary_dim] with row stride PS and unit inner stride:
+its first/second halves hold sine/cosine. O preserves X's layout, normally
+as BF16. Each lane owns one pair; non-rotary channels use adjacent pairs.
+The caller computes R with the original ATen reduction before this epilogue.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_refiner_qk_norm_rope_epilogue_kernel(
+    X,
+    R,
+    W,
+    M,
+    P,
+    Output,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    PS: tl.constexpr,
+    ROT: tl.constexpr,
+    NM: tl.constexpr,
+    B: tl.constexpr,
+    FP32: tl.constexpr,
+):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    mask = i < N * H * 64
+    d = i % 64
+    head = i // 64 % H
+    row = i // (64 * H)
+    rotating = d < ROT // 2
+    d0 = tl.where(rotating, d, 2 * d)
+    d1 = tl.where(rotating, d + ROT // 2, 2 * d + 1)
+    mod = tl.full((B,), 0, tl.int64)
+    if NM != 1:
+        mod = tl.load(M + row, mask, 0)
+    a = tl.load(X + row * H * 128 + head * 128 + d0, mask, 0)
+    b = tl.load(X + row * H * 128 + head * 128 + d1, mask, 0)
+    r = tl.load(R + row * H + head, mask, 0)
+    wa = tl.load(W + mod * 128 + d0, mask, 0)
+    wb = tl.load(W + mod * 128 + d1, mask, 0)
+    a = (a * r) * wa
+    b = (b * r) * wb
+    sin = tl.load(P + row * PS + d, mask & rotating, 0)
+    cos = tl.load(P + row * PS + d + ROT // 2, mask & rotating, 1)
+    # Keep the installed rotary expressions and one pair per physical thread.
+    # Larger tiles and explicit tl.fma differ on rounding/signed-zero cases.
+    c0 = a * cos - b * sin
+    c1 = a * sin + b * cos
+    o0 = tl.where(rotating, c0, a)
+    o1 = tl.where(rotating, c1, b)
+    if not FP32:
+        v0 = o0.to(tl.bfloat16)
+        v1 = o1.to(tl.bfloat16)
+        nan = tl.full((), 0x7FC0, tl.uint16).to(tl.bfloat16, bitcast=True)
+        o0 = tl.where(o0 != o0, nan, v0)
+        o1 = tl.where(o1 != o1, nan, v1)
+    tl.store(Output + row * H * 128 + head * 128 + d0, o0, mask)
+    tl.store(Output + row * H * 128 + head * 128 + d1, o1, mask)
+
+
+def epilogue(x, rstd, scale, modality, rope, out=None, block=256, fp32=False):
+    n, h, d = x.shape
+    assert d == 128 and x.is_contiguous() and x.dtype == torch.float32
+    assert rstd.is_contiguous() and scale.is_contiguous()
+    assert (
+        rope.ndim == 2
+        and rope.shape[0] == n
+        and 0 < rope.shape[1] <= 128
+        and rope.shape[1] % 2 == 0
+        and rope.stride(-1) == 1
+    )
+    assert rstd.shape == (n, h, 1) and rstd.dtype == torch.float32
+    assert scale.ndim == 2 and scale.shape[1] == 128 and scale.dtype == torch.float32
+    assert modality.shape == (n,) and modality.dtype == torch.int64 and modality.is_contiguous()
+    assert all(t.device == x.device for t in (rstd, scale, modality, rope))
+    if out is not None:
+        assert out.shape == x.shape and out.is_contiguous() and out.device == x.device
+        assert out.dtype == (torch.float32 if fp32 else torch.bfloat16)
+        assert out.untyped_storage().data_ptr() not in {
+            t.untyped_storage().data_ptr() for t in (x, rstd, scale, modality, rope)
+        }
+    if out is None:
+        out = torch.empty_like(x, dtype=torch.float32 if fp32 else torch.bfloat16)
+    assert block == 256
+    hcu_refiner_qk_norm_rope_epilogue_kernel[(triton.cdiv(n * h * 64, block),)](
+        x,
+        rstd,
+        scale,
+        modality,
+        rope,
+        out,
+        n,
+        h,
+        rope.stride(0),
+        rope.shape[1],
+        scale.shape[0],
+        block,
+        fp32,
+        num_warps=4,
+        enable_fp_fusion=True,
+    )
+    return out
+
+
+def supports_qkv(q, k, rope, q_weight, k_weight, num_modalities):
+    if torch.is_grad_enabled() or not torch.version.hip or not q.is_cuda:
+        return False
+    if q.ndim != 3 or k.ndim != 3 or q.shape[1:] != (32, 128) or k.shape[1:] != (8, 128):
+        return False
+    if (
+        q.shape[0] != k.shape[0]
+        or q.dtype not in (torch.float32, torch.bfloat16)
+        or k.dtype != q.dtype
+    ):
+        return False
+    if rope.shape != (q.shape[0], 96) or rope.dtype != torch.float32 or rope.stride(-1) != 1:
+        return False
+    if num_modalities not in (1, 3) or any(
+        w.dtype != torch.float32 or not w.is_contiguous() for w in (q_weight, k_weight)
+    ):
+        return False
+    if any(t.device != q.device for t in (k, rope, q_weight, k_weight)):
+        return False
+    return torch.cuda.get_device_properties(q.device).gcnArchName.split(":")[0] == "gfx936"
