+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Bounded static-layout cache and exact local sequence packing for preview."""
+import torch
+from torch.nn import functional as F
+from inference.infra.distributed import psm
+
+
+def layout_key(proxy, packed, padded_size):
+    # Values, not tensor addresses: noisy features and timesteps change every
+    # step. Every field used by coords/modality/varlen construction is included.
+    items = tuple(
+        (
+            i.t,
+            i.h,
+            i.w,
+            i.patch_size,
+            i.t_patch_size,
+            i.spatial_rope_interpolation,
+            i.video_token_num,
+            i.audio_feat_len,
+            i.txt_feat_len,
+            i.add_time_token,
+            i.time_channel_dim,
+            i.vae_first_latent_is_image,
+            i.video_fps,
+            i.time_pos_fps,
+            tuple(tuple(v) for v in i.ref_image_feat_lens),
+        )
+        for i in packed.items
+    )
+    return (
+        packed.device,
+        torch.cuda.current_stream(packed.device).cuda_stream,
+        packed.default_dtype,
+        proxy.config.model_dump_json(),
+        items,
+        padded_size,
+        id(psm.get_parallel_group("cp")),
+        id(psm.get_parallel_group("ep")),
+    )
+
+
+def pack_local(packed, padded_size):
+    world = psm.get_world_size("cp")
+    rank = psm.get_local_rank("cp")
+    assert padded_size % world == 0
+    size = padded_size // world
+    start = rank * size
+    end = start + size
+    parts = (
+        packed.items[0].feat_to_cat
+        if len(packed.items) == 1
+        else [p for i in packed.items for p in i.feat_to_cat]
+    )
+    channels = max(p.shape[-1] for p in parts)
+    output = torch.zeros((size, channels), device=packed.device, dtype=packed.default_dtype)
+    offset = 0
+    for part in parts:
+        lo = max(start, offset)
+        hi = min(end, offset + part.shape[0])
+        if hi > lo:
+            output[lo - start : hi - start, : part.shape[-1]].copy_(part[lo - offset : hi - offset])
+        offset += part.shape[0]
+    return output
+
+
+def process_cached(proxy, packed, input_video_channel, local_pack):
+    from .preview_data_proxy import VarlenHandler
+
+    # Always run the same collectives on every rank, even on a local cache hit.
+    target = proxy._reduce_max_token_num_for_ep_cp(packed.total_token_num)
+    padded_size = ((target + 47) // 48) * 48
+    pad = padded_size - packed.total_token_num
+    key = layout_key(proxy, packed, padded_size)
+    cache = getattr(proxy, "_preview_static_layout", None)
+    if cache is None or cache[0] != key:
+        # These cache-owned tensors outlive a denoising step. Retain mutation
+        # versions even under inference_mode so the model cache can validate them.
+        with torch.inference_mode(False):
+            vh = VarlenHandler(
+                cu_seqlens_q=packed.cu_seqlen.to(device=packed.device, dtype=torch.int32),
+                cu_seqlens_k=packed.cu_seqlen.to(device=packed.device, dtype=torch.int32),
+                max_seqlen_q=packed.max_seqlen,
+                max_seqlen_k=packed.max_seqlen,
+            )
+            # Zero channels avoids building the expensive full feature tensor just
+            # to reuse the original padding semantics for the static metadata.
+            dummy = torch.empty(
+                (packed.total_token_num, 0),
+                device=packed.device,
+                dtype=packed.default_dtype,
+            )
+            _, coords, modal, _, vh, pad = proxy._pad_for_ep_cp(
+                dummy,
+                packed.coords_mapping,
+                packed.modality_mapping,
+                dummy,
+                vh,
+                target_size=target,
+            )
+        cache = (key, coords, modal, vh, pad)
+        proxy._preview_static_layout = cache
+    _, coords, modal, vh, pad = cache
+    tokens = (
+        pack_local(packed, padded_size)
+        if local_pack
+        else (F.pad(packed.token_sequence, (0, 0, 0, pad)) if pad else packed.token_sequence)
+    )
+    times = packed.time_token_sequence
+    if pad:
+        times = (
+            times.new_zeros(padded_size, 0)
+            if times.shape[-1] == 0
+            else F.pad(times, (0, 0, 0, pad))
+        )
+    proxy.saved_for_output(
+        simple_packed_data=packed, input_video_channel=input_video_channel, pad_size=pad
+    )
+    result = (tokens, coords, modal, vh, times)
+    return (*result, True) if local_pack else result
