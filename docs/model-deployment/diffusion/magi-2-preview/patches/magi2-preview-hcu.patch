--- /dev/null
+++ b/inference/model/preview_cp_overlap.py
@@ -0,0 +1,230 @@
+"""Overlap complete-head CP exchanges without splitting attention reductions.
+
+CP8 partitions 24 heads into three per rank. Complete groups of one
+and two heads retain each head's entire key reduction. Received return buffers
+are [source rank, local tokens, group heads, 128]; unpack writes each group's
+head offset into [local tokens, 24, 128]. Lists retain send/receive tensors and
+Work handles until waits order all consumers on the caller's compute stream.
+"""
+
+import os
+from contextvars import ContextVar
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+
+from inference.common.device import is_dcu
+from inference.model.preview_fa_layout import allocate_kv_workspace, prepare_kv
+from inference.model.preview_fa_sink import correct
+from inference.model.preview_qkv_pack import preview_qkv_norm_rope_cp_pack
+
+_calls = 0
+
+# Scoped by the sampler; an unprepared or unsupported caller keeps the serial path.
+_attention_stream = ContextVar("hcu_preview_attention_stream", default=None)
+
+
+def call_count():
+    return _calls
+
+
+@triton.jit
+def hcu_preview_cp_head_group_output_unpack_kernel(
+    X, Y, L: tl.constexpr, H: tl.constexpr, OFFSET: tl.constexpr, B: tl.constexpr
+):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    row = i // (H * 128)
+    col = i % (H * 128)
+    source_rank = row // L
+    local_row = row % L
+    value = tl.load(X + i, mask=row < 8 * L, other=0)
+    destination = local_row * 3072 + source_rank * 384 + OFFSET * 128 + col
+    tl.store(Y + destination, value, mask=row < 8 * L)
+
+
+def maybe_attention(
+    q,
+    k,
+    v,
+    qw,
+    kw,
+    rope,
+    inv,
+    cug,
+    eps,
+    group,
+    cuq,
+    cuk,
+    maxq,
+    maxk,
+    sinks,
+    softcap,
+):
+    """Return None when the original CP path should handle this invocation."""
+    if not (
+        is_dcu()
+        and not torch.is_grad_enabled()
+        and os.environ.get("MAGI2_HCU_DISABLE_PREVIEW_CP_OVERLAP", "0") != "1"
+        and group is not None
+        and dist.get_world_size(group) == 8
+        and q.is_cuda
+        and q.device == k.device == v.device
+        and q.dtype == k.dtype == v.dtype == torch.bfloat16
+        and q.shape == k.shape == v.shape == (15126, 24, 128)
+        and all(x.stride(2) == 1 for x in (q, k, v))
+        and cuq is not None
+        and cuk is not None
+        and maxq == maxk
+        and maxq >= 16384
+        and cuq.device == q.device == cuk.device
+        and cuq.dtype == cuk.dtype == torch.int32
+        and cuq.is_contiguous()
+        and cuk.is_contiguous()
+        and cuq.numel() == cuk.numel()
+        and cuq.numel() >= 2
+        and sinks.shape == (1, 24)
+        and sinks.dtype == torch.float32
+        and sinks.device == q.device
+        and softcap <= 0
+    ):
+        return None
+    return attention(
+        q,
+        k,
+        v,
+        qw,
+        kw,
+        rope,
+        inv,
+        cug,
+        eps,
+        group,
+        cuq,
+        cuk,
+        maxq,
+        maxk,
+        sinks,
+    )
+
+
+def _group_attention(q, k, v, cuq, cuk, maxq, maxk, *, workspace=None):
+    """Keep each head's full reduction on the standard FA interface."""
+    from flash_attn import flash_attn_varlen_func
+
+    k, v = prepare_kv(k, v, workspace=workspace)
+    output, lse, _ = flash_attn_varlen_func(
+        q, k, v, cuq, cuk, maxq, maxk,
+        softmax_scale=q.shape[-1] ** -0.5,
+        return_attn_probs=True,
+    )
+    return output, lse
+
+
+def attention(
+    q,
+    k,
+    v,
+    qw,
+    kw,
+    rope,
+    inv,
+    cug,
+    eps,
+    group,
+    cuq,
+    cuk,
+    maxq,
+    maxk,
+    sinks,
+):
+    """Internal pipeline for CP8, 24 heads and head dimension 128."""
+    global _calls
+    _calls += 1
+    local_tokens = q.shape[0]
+    device = q.device
+    splits = [local_tokens] * 8
+    rank = dist.get_rank(group)
+    local_sink = sinks[:, rank * 3 : rank * 3 + 3].contiguous()
+    inputs = []
+    outputs = []
+
+    # The second pack covers the first exchange. Its exchange is then queued
+    # before FA starts, so it can run while the first complete head is computed.
+    for offset, heads in ((0, 1), (1, 2)):
+        send = preview_qkv_norm_rope_cp_pack(q, k, v, qw, kw, rope, inv, cug, 8, eps, offset, heads)
+        received = torch.empty_like(send)
+        work = dist.all_to_all_single(
+            received,
+            send,
+            output_split_sizes=splits,
+            input_split_sizes=splits,
+            group=group,
+            async_op=True,
+        )
+        inputs.append((send, received, work, heads, offset))
+
+    second_stream = _attention_stream.get()
+    parallel_results = None
+    if second_stream is not None:
+        caller = torch.cuda.current_stream(device)
+        second_qkv = inputs[1][1].split(2, dim=1)
+        workspace = allocate_kv_workspace(second_qkv[0])
+        # Caller-owned storage remains alive until both FA consumers are joined.
+        inputs_ready = torch.cuda.Event()
+        inputs_ready.record(caller)
+        inputs[0][2].wait()
+        first = _group_attention(*inputs[0][1].split(1, dim=1), cuq, cuk, maxq, maxk)
+        # Pending auxiliary barriers can slow earlier caller kernels on HCU.
+        # Submit FA1 first, then wait only through input preparation on the host;
+        # FA1 can continue while we submit FA2, without an early GPU-side wait.
+        inputs_ready.synchronize()
+        second_stream.wait_event(inputs_ready)
+        with torch.cuda.stream(second_stream):
+            inputs[1][2].wait()
+            second = _group_attention(
+                *second_qkv, cuq, cuk, maxq, maxk, workspace=workspace
+            )
+        caller.wait_stream(second_stream)
+        # FA allocates on the auxiliary stream; sink correction consumes on the caller.
+        for tensor in second:
+            tensor.record_stream(caller)
+        parallel_results = (first, second)
+
+    for index, (send, received, work, heads, offset) in enumerate(inputs):
+        if parallel_results is None:
+            work.wait()
+            q_group, k_group, v_group = received.split(heads, dim=1)
+            raw, lse = _group_attention(q_group, k_group, v_group, cuq, cuk, maxq, maxk)
+        else:
+            raw, lse = parallel_results[index]
+        corrected = correct(
+            raw, lse, local_sink[:, offset : offset + heads].contiguous()
+        )
+        returned = torch.empty_like(corrected)
+        return_work = dist.all_to_all_single(
+            returned,
+            corrected,
+            output_split_sizes=splits,
+            input_split_sizes=splits,
+            group=group,
+            async_op=True,
+        )
+        outputs.append((corrected, returned, return_work, heads, offset))
+
+    result = torch.empty((local_tokens, 24, 128), device=device, dtype=torch.bfloat16)
+    for send, received, work, heads, offset in outputs:
+        work.wait()
+        hcu_preview_cp_head_group_output_unpack_kernel[(triton.cdiv(received.numel(), 1024),)](
+            received.view(torch.int16),
+            result.view(torch.int16),
+            local_tokens,
+            heads,
+            offset,
+            1024,
+            num_warps=4,
+        )
+    # Keep every send/receive buffer and Work owned until its consumer has been
+    # ordered on the caller stream. Downstream sees the original complete heads.
+    return result
