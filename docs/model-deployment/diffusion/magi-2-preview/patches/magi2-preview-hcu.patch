index 0000000..ace887e
--- /dev/null
+++ b/inference/model/refiner_cp_pack.py
@@ -0,0 +1,95 @@
+"""Bit-preserving QKV packing for the existing Refiner CP8 all-to-all.
+
+Input Q/K/V have 32/8/8 heads of 128 elements. Output storage is
+[CP destination, local token, 6, 128], exposed as [8 * local tokens, 6, 128].
+Each destination receives four Q heads, one K head and one V head (768
+elements). Copy through int16 views to preserve every BF16 bit. The guarded
+HCU caller owns device dispatch; unsupported layouts return None.
+"""
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_refiner_cp_qkv_pack_kernel(
+    Q,
+    K,
+    V,
+    Output,
+    N: tl.constexpr,
+    QS: tl.constexpr,
+    KS: tl.constexpr,
+    VS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    valid = i < 8 * N * 768
+    column = i % 768
+    row = i // 768 % N
+    cp = i // 768 // N
+    q = tl.load(Q + row * QS + cp * 512 + column, valid & (column < 512), 0)
+    k = tl.load(K + row * KS + cp * 128 + column - 512, valid & (column >= 512) & (column < 640), 0)
+    v = tl.load(V + row * VS + cp * 128 + column - 640, valid & (column >= 640), 0)
+    value = tl.where(column < 512, q, tl.where(column < 640, k, v))
+    tl.store(Output + i, value, valid)
+
+
+def pack_qkv(q, k, v):
+    n = q.shape[0]
+    if not (
+        n > 0
+        and q.is_cuda
+        and (q.dtype == k.dtype == v.dtype == torch.bfloat16)
+        and (q.ndim == k.ndim == v.ndim == 3)
+        and (q.shape == (n, 32, 128))
+        and (k.shape == v.shape == (n, 8, 128))
+        and (q.device == k.device == v.device)
+        and all((x.stride(1) == 128 and x.stride(2) == 1 for x in (q, k, v)))
+    ):
+        return None
+    output = torch.empty((8 * n, 6, 128), device=q.device, dtype=q.dtype)
+    hcu_refiner_cp_qkv_pack_kernel[triton.cdiv(output.numel(), 4096),](
+        q.view(torch.int16),
+        k.view(torch.int16),
+        v.view(torch.int16),
+        output.view(torch.int16),
+        n,
+        q.stride(0),
+        k.stride(0),
+        v.stride(0),
+        4096,
+        num_warps=4,
+    )
+    return output
+
+
+def maybe_batch_scatter(inputs, split_sizes, group):
+    if (
+        group is None
+        or dist.get_world_size(group) != 8
+        or len(inputs) != 3
+        or (split_sizes is None)
+    ):
+        return None
+    if inputs[0].shape[0] < 4096 or any((x.requires_grad for x in inputs)):
+        return None
+    if len(split_sizes) != 8 or any(
+        (x.shape[0] != split_sizes[dist.get_rank(group)] for x in inputs)
+    ):
+        return None
+    fused = pack_qkv(*inputs)
+    if fused is None:
+        return None
+    output = torch.empty((sum(split_sizes), 6, 128), device=fused.device, dtype=fused.dtype)
+    dist.all_to_all_single(
+        output,
+        fused,
+        output_split_sizes=split_sizes,
+        input_split_sizes=[inputs[0].shape[0]] * 8,
+        group=group,
+        async_op=False,
+    )
+    return torch.split(output, (4, 1, 1), dim=1)
