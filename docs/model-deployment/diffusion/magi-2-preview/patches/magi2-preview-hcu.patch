diff --git a/inference/compiler_compat.py b/inference/compiler_compat.py
new file mode 100644
index 0000000..ddb4d08
--- /dev/null
+++ b/inference/compiler_compat.py
@@ -0,0 +1,61 @@
+"""Optional MagiCompiler integration with an eager inference fallback."""
+
+from __future__ import annotations
+
+import gc
+from typing import Any, Callable
+
+try:
+    from magi_compiler import magi_compile, magi_register_custom_op
+    from magi_compiler.config import CompileConfig
+except ImportError:
+
+    class CompileConfig:
+        """Type placeholder used by config patch callbacks in eager mode."""
+
+    def magi_compile(obj=None, **_kwargs):
+        if obj is None:
+            return lambda target: target
+        return obj
+
+    def magi_register_custom_op(
+        _name: str | None = None,
+        **_kwargs: Any,
+    ) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+        return lambda fn: fn
+
+
+def release_magi_compile_jit_inputs() -> int:
+    """Drop compile-only GPU inputs after a JIT-compiled stage is offloaded.
+
+    MagiCompiler's JIT runtime calls ``optimized_call`` directly, but its
+    serializable wrapper also keeps the real first-call inputs for optional
+    artifact serialization.  Those inputs include every lifted model weight
+    and otherwise keep an offloaded model resident on the GPU.  AOT wrappers
+    retain their inputs because they may still need serialization/rebuild.
+
+    Returns the number of JIT wrappers released.
+    """
+
+    try:
+        from magi_compiler.magi_backend.compile_artifacts import (
+            MagiSerializableFunction,
+        )
+    except ImportError:
+        return 0
+
+    released = 0
+    for obj in gc.get_objects():
+        # ``gc.get_objects()`` can contain dead weakref proxies.  Exact type
+        # comparison does not dereference them, while ``isinstance`` does.
+        if type(obj) is not MagiSerializableFunction:
+            continue
+        compile_config = getattr(obj, "compile_config", None)
+        if compile_config is not None and getattr(compile_config, "aot", False):
+            continue
+        example_inputs = getattr(obj, "example_inputs", None)
+        if not example_inputs:
+            continue
+        obj.example_inputs = []
+        released += 1
+    return released
