+# Copyright (c) 2025-2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Two-stage Triton backend for MAGI-2 multi-head MoE inference.
+
+This backend follows the grouped-GEMM structure used by AITER's Triton MoE:
+each program owns a conventional [token, feature] output tile.  It avoids the
+large [BLOCK_T, d_head] accumulator that requires a special layout workaround
+on gfx936.  Intermediate activations are processed in bounded tile chunks so
+the full routed-token activation tensor is never materialized.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from inference.common.device import is_dcu
+
+
+SWIGLU7_ALPHA = tl.constexpr(1.702)
+SWIGLU7_LIMIT = tl.constexpr(7.0)
+SWIGLU7_BIAS = tl.constexpr(1.0)
+
+
+@triton.jit
+def _binary_search_expert_id(
+    cu_expert_tile_counts_ptr,
+    tile_id,
+    NUM_EXPERTS: tl.constexpr,
+    LOG2_NUM_EXPERTS: tl.constexpr,
+):
+    lo = 0
+    hi = NUM_EXPERTS
+    for _ in tl.static_range(0, LOG2_NUM_EXPERTS + 1):
+        mid = (lo + hi + 1) // 2
+        below = tl.load(cu_expert_tile_counts_ptr + mid) <= tile_id
+        lo = tl.where(below, mid, lo)
+        hi = tl.where(below, hi, mid - 1)
+    return lo
+
+
+@triton.jit
+def _mh_moe_tile_metadata_kernel(
+    expert_offsets_ptr,
+    cu_expert_tile_counts_ptr,
+    tile_expert_ids_ptr,
+    tile_token_starts_ptr,
+    tile_token_ends_ptr,
+    NUM_EXPERTS: tl.constexpr,
+    LOG2_NUM_EXPERTS: tl.constexpr,
+    BLOCK_T: tl.constexpr,
+):
+    tile_id = tl.program_id(0)
+    total_tiles = tl.load(cu_expert_tile_counts_ptr + NUM_EXPERTS)
+    if tile_id >= total_tiles:
+        tl.store(tile_expert_ids_ptr + tile_id, -1)
+        return
+    expert_id = _binary_search_expert_id(
+        cu_expert_tile_counts_ptr, tile_id, NUM_EXPERTS, LOG2_NUM_EXPERTS
+    )
+    tile_in_expert = tile_id - tl.load(cu_expert_tile_counts_ptr + expert_id)
+    token_start = tl.load(expert_offsets_ptr + expert_id) + tile_in_expert * BLOCK_T
+    expert_end = tl.load(expert_offsets_ptr + expert_id + 1)
+    tl.store(tile_expert_ids_ptr + tile_id, expert_id)
+    tl.store(tile_token_starts_ptr + tile_id, token_start)
+    tl.store(tile_token_ends_ptr + tile_id, expert_end)
+
+
+@triton.jit
+def _mh_moe_stage1_kernel(
+    x_ptr,
+    wg_ptr,
+    wu_ptr,
+    hidden_ptr,
+    gather_ids_ptr,
+    tile_expert_ids_ptr,
+    tile_token_starts_ptr,
+    tile_token_ends_ptr,
+    tile_base,
+    stride_x_s,
+    stride_x_h,
+    stride_x_dh,
+    stride_wg_ne,
+    stride_wg_dh,
+    stride_wg_de,
+    stride_wu_ne,
+    stride_wu_dh,
+    stride_wu_de,
+    stride_hidden_tile,
+    stride_hidden_t,
+    stride_hidden_de,
+    D_HEAD: tl.constexpr,
+    D_EXPERT: tl.constexpr,
+    NUM_HEADS: tl.constexpr,
+    NUM_EXPERTS: tl.constexpr,
+    BLOCK_T: tl.constexpr,
+    BLOCK_DE: tl.constexpr,
+    BLOCK_DH: tl.constexpr,
+):
+    local_tile_id = tl.program_id(0)
+    de_block_id = tl.program_id(1)
+    tile_id = tile_base + local_tile_id
+
+    expert_id = tl.load(tile_expert_ids_ptr + tile_id)
+    if expert_id < 0:
+        return
+    expert_id_i64 = expert_id.to(tl.int64)
+    head_id = expert_id // (NUM_EXPERTS // NUM_HEADS)
+    token_start = tl.load(tile_token_starts_ptr + tile_id)
+    expert_end = tl.load(tile_token_ends_ptr + tile_id)
+
+    t_offs = tl.arange(0, BLOCK_T)
+    dh_offs = tl.arange(0, BLOCK_DH)
+    de_offs = de_block_id * BLOCK_DE + tl.arange(0, BLOCK_DE)
+    sorted_pos = token_start + t_offs
+    token_mask = sorted_pos < expert_end
+    de_mask = de_offs < D_EXPERT
+    gather_ids = tl.load(gather_ids_ptr + sorted_pos, mask=token_mask, other=0)
+    x_base = gather_ids * stride_x_s + head_id * stride_x_h
+
+    gate_acc = tl.zeros((BLOCK_T, BLOCK_DE), dtype=tl.float32)
+    up_acc = tl.zeros((BLOCK_T, BLOCK_DE), dtype=tl.float32)
+    for dh_start in tl.static_range(0, D_HEAD, BLOCK_DH):
+        current_dh = dh_start + dh_offs
+        x = tl.load(
+            x_ptr + x_base[:, None] + current_dh[None, :] * stride_x_dh,
+            mask=token_mask[:, None],
+            other=0.0,
+        )
+        wg = tl.load(
+            wg_ptr
+            + expert_id_i64 * stride_wg_ne
+            + current_dh[:, None] * stride_wg_dh
+            + de_offs[None, :] * stride_wg_de,
+            mask=de_mask[None, :],
+            other=0.0,
+        )
+        wu = tl.load(
+            wu_ptr
+            + expert_id_i64 * stride_wu_ne
+            + current_dh[:, None] * stride_wu_dh
+            + de_offs[None, :] * stride_wu_de,
+            mask=de_mask[None, :],
+            other=0.0,
+        )
+        gate_acc += tl.dot(x, wg)
+        up_acc += tl.dot(x, wu)
+
+    gate = tl.minimum(gate_acc, SWIGLU7_LIMIT)
+    up = tl.maximum(tl.minimum(up_acc, SWIGLU7_LIMIT), -SWIGLU7_LIMIT)
+    hidden = gate * tl.sigmoid(SWIGLU7_ALPHA * gate) * (up + SWIGLU7_BIAS)
+    hidden_ptrs = (
+        hidden_ptr
+        + local_tile_id * stride_hidden_tile
+        + t_offs[:, None] * stride_hidden_t
+        + de_offs[None, :] * stride_hidden_de
+    )
+    tl.store(
+        hidden_ptrs,
+        hidden.to(hidden_ptr.dtype.element_ty),
+        mask=token_mask[:, None] & de_mask[None, :],
+    )
+
+
+@triton.jit
+def _mh_moe_stage2_kernel(
+    hidden_ptr,
+    wd_ptr,
+    y_ptr,
+    gather_ids_ptr,
+    probs_ptr,
+    route_ids_ptr,
+    tile_expert_ids_ptr,
+    tile_token_starts_ptr,
+    tile_token_ends_ptr,
+    tile_base,
+    stride_hidden_tile,
+    stride_hidden_t,
+    stride_hidden_de,
+    stride_wd_ne,
+    stride_wd_de,
+    stride_wd_dh,
+    stride_y_s,
+    stride_y_h,
+    stride_y_dh,
+    D_HEAD: tl.constexpr,
+    D_EXPERT: tl.constexpr,
+    NUM_HEADS: tl.constexpr,
+    NUM_EXPERTS: tl.constexpr,
+    BLOCK_T: tl.constexpr,
+    BLOCK_DH: tl.constexpr,
+    BLOCK_DE: tl.constexpr,
+    ROUTED_OUTPUT: tl.constexpr,
+):
+    local_tile_id = tl.program_id(0)
+    dh_block_id = tl.program_id(1)
+    tile_id = tile_base + local_tile_id
+
+    expert_id = tl.load(tile_expert_ids_ptr + tile_id)
+    if expert_id < 0:
+        return
+    expert_id_i64 = expert_id.to(tl.int64)
+    head_id = expert_id // (NUM_EXPERTS // NUM_HEADS)
+    token_start = tl.load(tile_token_starts_ptr + tile_id)
+    expert_end = tl.load(tile_token_ends_ptr + tile_id)
+
+    t_offs = tl.arange(0, BLOCK_T)
+    dh_offs = dh_block_id * BLOCK_DH + tl.arange(0, BLOCK_DH)
+    de_offs = tl.arange(0, BLOCK_DE)
+    sorted_pos = token_start + t_offs
+    token_mask = sorted_pos < expert_end
+    dh_mask = dh_offs < D_HEAD
+    gather_ids = tl.load(gather_ids_ptr + sorted_pos, mask=token_mask, other=0)
+    probs = tl.load(probs_ptr + sorted_pos, mask=token_mask, other=0.0)
+
+    acc = tl.zeros((BLOCK_T, BLOCK_DH), dtype=tl.float32)
+    for de_start in tl.range(0, D_EXPERT, BLOCK_DE):
+        current_de = de_start + de_offs
+        hidden = tl.load(
+            hidden_ptr
+            + local_tile_id * stride_hidden_tile
+            + t_offs[:, None] * stride_hidden_t
+            + current_de[None, :] * stride_hidden_de,
+            mask=token_mask[:, None] & (current_de[None, :] < D_EXPERT),
+            other=0.0,
+        )
+        wd = tl.load(
+            wd_ptr
+            + expert_id_i64 * stride_wd_ne
+            + current_de[:, None] * stride_wd_de
+            + dh_offs[None, :] * stride_wd_dh,
+            mask=(current_de[:, None] < D_EXPERT) & dh_mask[None, :],
+            other=0.0,
+        )
+        acc += tl.dot(hidden, wd)
+
+    acc *= probs[:, None]
+    if ROUTED_OUTPUT:
+        route_ids = tl.load(route_ids_ptr + sorted_pos, mask=token_mask, other=0)
+        tl.store(
+            y_ptr
+            + route_ids[:, None] * stride_y_s
+            + dh_offs[None, :] * stride_y_dh,
+            acc.to(y_ptr.dtype.element_ty),
+            mask=token_mask[:, None] & dh_mask[None, :],
+        )
+    else:
+        y_base = gather_ids * stride_y_s + head_id * stride_y_h
+        tl.atomic_add(
+            y_ptr + y_base[:, None] + dh_offs[None, :] * stride_y_dh,
+            acc.to(y_ptr.dtype.element_ty),
+            mask=token_mask[:, None] & dh_mask[None, :],
+        )
+
+
+@triton.jit
+def _mh_moe_route_reduce_kernel(
+    routed_ptr,
+    y_ptr,
+    stride_routed_t,
+    stride_routed_dh,
+    stride_y_s,
+    stride_y_h,
+    stride_y_dh,
+    SEQUENCE: tl.constexpr,
+    TOP_K: tl.constexpr,
+    D_HEAD: tl.constexpr,
+):
+    head_token_id = tl.program_id(0)
+    head_id = head_token_id // SEQUENCE
+    token_id = head_token_id - head_id * SEQUENCE
+    dh_offs = tl.arange(0, D_HEAD)
+    route_base = head_token_id * TOP_K
+    acc = tl.zeros((D_HEAD,), dtype=tl.float32)
+    for route_slot in tl.static_range(0, TOP_K):
+        acc += tl.load(
+            routed_ptr
+            + (route_base + route_slot) * stride_routed_t
+            + dh_offs * stride_routed_dh
+        )
+    tl.store(
+        y_ptr
+        + token_id * stride_y_s
+        + head_id * stride_y_h
+        + dh_offs * stride_y_dh,
+        acc.to(y_ptr.dtype.element_ty),
+    )
+
+
+def mh_moe_fwd_two_stage(
+    x: torch.Tensor,
+    gather_ids: torch.Tensor,
+    probs: torch.Tensor,
+    expert_offsets: torch.Tensor,
+    W_gate: torch.Tensor,
+    W_up: torch.Tensor,
+    W_down: torch.Tensor,
+    route_ids: torch.Tensor | None = None,
+    routed_reduce: bool = False,
+    route_capacity: int | None = None,
+    chunk_tile_limit: int | None = None,
+) -> torch.Tensor:
+    """Execute chunked two-stage grouped GEMMs.
+
+    The default path uses FP32 atomic scatter. ``routed_reduce`` instead writes
+    each weighted route once in BF16 and reduces the top-k routes per token in
+    a separate FP32-accumulating kernel, removing the contended atomics.
+    """
+    if gather_ids.numel() == 0:
+        return torch.zeros_like(x)
+
+    num_heads = x.size(1)
+    d_head = x.size(2)
+    d_expert = W_down.size(1)
+    num_experts = expert_offsets.numel() - 1
+    log2_num_experts = max(1, math.ceil(math.log2(max(num_experts, 1) + 1)))
+    routes_per_token = 0
+    if routed_reduce:
+        if route_ids is None or route_ids.numel() != gather_ids.numel():
+            raise ValueError("two_stage_reduce requires one route id per routed token")
+        output_route_count = (
+            gather_ids.numel() if route_capacity is None else route_capacity
+        )
+        if output_route_count < gather_ids.numel():
+            raise ValueError("route capacity must include all written routes")
+        routes_per_token = output_route_count // (x.size(0) * num_heads)
+        if routes_per_token * x.size(0) * num_heads != output_route_count:
+            raise ValueError("routed token count must be divisible by sequence * heads")
+
+    # Production configuration validated for CP8/EP8 on HCU.
+    block_t, block_de, block_dh = 64, 128, 128
+    chunk_tiles = 2048
+    # Chunk boundaries preserve arithmetic only for the fixed route-slot reduce.
+    # Leave the generic atomic-scatter path and unvalidated shapes unchanged.
+    if (
+        is_dcu()
+        and routed_reduce
+        and d_head == 256
+        and d_expert == 1280
+        and x.dtype == W_down.dtype == torch.bfloat16
+    ):
+        chunk_tiles = 8192
+    if chunk_tile_limit is not None:
+        if chunk_tile_limit <= 0:
+            raise ValueError("chunk_tile_limit must be positive")
+        chunk_tiles = min(chunk_tiles, chunk_tile_limit)
+    stage1_num_warps = stage2_num_warps = reduce_num_warps = 4
+    stage1_num_stages = stage2_num_stages = 1
+    stage1_waves_per_eu = stage2_waves_per_eu = 1
+    stage1_kpack = stage2_kpack = 1
+    if d_head % block_dh != 0 or d_head % block_de != 0:
+        raise ValueError("d_head must be divisible by BLOCK_DH and BLOCK_DE")
+    if d_expert % block_de != 0:
+        raise ValueError("d_expert must be divisible by BLOCK_DE")
+
+    expert_counts = expert_offsets.diff()
+    expert_tile_counts = (expert_counts + block_t - 1) // block_t
+    cu_tile_counts = torch.cat(
+        (
+            torch.zeros(1, dtype=torch.int32, device=expert_offsets.device),
+            torch.cumsum(expert_tile_counts, dim=0, dtype=torch.int32),
+        )
+    )
+    # Use the same synchronization-free upper bound as the fused backend.
+    # Programs beyond the device-computed total tile count return immediately.
+    max_tiles = (gather_ids.numel() + block_t - 1) // block_t + num_experts
+    hidden = torch.empty(
+        (min(chunk_tiles, max_tiles), block_t, d_expert),
+        device=x.device,
+        dtype=W_down.dtype,
+    )
+    if routed_reduce:
+        # A subset retains original route IDs. Uncomputed slots must be zero;
+        # their token outputs are replaced by the complete helper result.
+        allocate_routes = torch.empty if route_capacity is None else torch.zeros
+        routed_output = allocate_routes(
+            (output_route_count, d_head),
+            device=x.device,
+            dtype=W_down.dtype,
+        )
+        y = torch.empty_like(x)
+    else:
+        routed_output = None
+        y = torch.zeros(x.shape, device=x.device, dtype=torch.float32)
+    tile_expert_ids = torch.empty(
+        (max_tiles,), device=x.device, dtype=torch.int32
+    )
+    tile_token_starts = torch.empty(
+        (max_tiles,), device=x.device, dtype=torch.int32
+    )
+    tile_token_ends = torch.empty(
+        (max_tiles,), device=x.device, dtype=torch.int32
+    )
+    stage1_hip_options = {}
+    stage2_hip_options = {}
+    if is_dcu():
+        stage1_hip_options = {
+            "matrix_instr_nonkdim": 16,
+            "kpack": stage1_kpack,
+            "waves_per_eu": stage1_waves_per_eu,
+        }
+        stage2_hip_options = {
+            "matrix_instr_nonkdim": 16,
+            "kpack": stage2_kpack,
+            "waves_per_eu": stage2_waves_per_eu,
+        }
+
+    _mh_moe_tile_metadata_kernel[(max_tiles,)](
+        expert_offsets,
+        cu_tile_counts,
+        tile_expert_ids,
+        tile_token_starts,
+        tile_token_ends,
+        NUM_EXPERTS=num_experts,
+        LOG2_NUM_EXPERTS=log2_num_experts,
+        BLOCK_T=block_t,
+        num_warps=1,
+    )
+
+    for tile_base in range(0, max_tiles, chunk_tiles):
+        active_tiles = min(chunk_tiles, max_tiles - tile_base)
+        stage1_grid = (active_tiles, triton.cdiv(d_expert, block_de))
+        _mh_moe_stage1_kernel[stage1_grid](
+            x,
+            W_gate,
+            W_up,
+            hidden,
+            gather_ids,
+            tile_expert_ids,
+            tile_token_starts,
+            tile_token_ends,
+            tile_base,
+            x.stride(0),
+            x.stride(1),
+            x.stride(2),
+            W_gate.stride(0),
+            W_gate.stride(1),
+            W_gate.stride(2),
+            W_up.stride(0),
+            W_up.stride(1),
+            W_up.stride(2),
+            hidden.stride(0),
+            hidden.stride(1),
+            hidden.stride(2),
+            D_HEAD=d_head,
+            D_EXPERT=d_expert,
+            NUM_HEADS=num_heads,
+            NUM_EXPERTS=num_experts,
+            BLOCK_T=block_t,
+            BLOCK_DE=block_de,
+            BLOCK_DH=block_dh,
+            num_warps=stage1_num_warps,
+            num_stages=stage1_num_stages,
+            **stage1_hip_options,
+        )
+        stage2_grid = (active_tiles, triton.cdiv(d_head, block_dh))
+        stage2_output = routed_output if routed_reduce else y
+        assert stage2_output is not None
+        _mh_moe_stage2_kernel[stage2_grid](
+            hidden,
+            W_down,
+            stage2_output,
+            gather_ids,
+            probs,
+            route_ids if route_ids is not None else gather_ids,
+            tile_expert_ids,
+            tile_token_starts,
+            tile_token_ends,
+            tile_base,
+            hidden.stride(0),
+            hidden.stride(1),
+            hidden.stride(2),
+            W_down.stride(0),
+            W_down.stride(1),
+            W_down.stride(2),
+            stage2_output.stride(0),
+            0 if routed_reduce else stage2_output.stride(1),
+            stage2_output.stride(-1),
+            D_HEAD=d_head,
+            D_EXPERT=d_expert,
+            NUM_HEADS=num_heads,
+            NUM_EXPERTS=num_experts,
+            BLOCK_T=block_t,
+            BLOCK_DH=block_dh,
+            BLOCK_DE=block_de,
+            ROUTED_OUTPUT=routed_reduce,
+            num_warps=stage2_num_warps,
+            num_stages=stage2_num_stages,
+            **stage2_hip_options,
+        )
+
+    if routed_reduce:
+        assert routed_output is not None
+        _mh_moe_route_reduce_kernel[(x.size(0) * num_heads,)](
+            routed_output,
+            y,
+            routed_output.stride(0),
+            routed_output.stride(1),
+            y.stride(0),
+            y.stride(1),
+            y.stride(2),
+            SEQUENCE=x.size(0),
+            TOP_K=routes_per_token,
+            D_HEAD=d_head,
+            num_warps=reduce_num_warps,
+        )
+        return y
+
+    return y.to(dtype=x.dtype)
diff --git a/inference/flash_mh_moe/triton/route_csr.py b/inference/flash_mh_moe/triton/route_csr.py
new file mode 100644
index 0000000..272ab94
--- /dev/null
+++ b/inference/flash_mh_moe/triton/route_csr.py
@@ -0,0 +1,160 @@
+"""Direct CSR construction for MAGI-2 multi-head MoE routing.
+
+The routed-reduce backend writes every route to its original ``route_id`` and
+then reduces the fixed top-k slots.  It therefore only requires routes to be
+grouped by expert; their order within an expert does not affect the result.
+This lets us replace a global stable argsort with counting sort.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _route_histogram_kernel(
+    topk_indices_ptr,
+    expert_counts_ptr,
+    num_routes: tl.constexpr,
+    routes_per_head: tl.constexpr,
+    num_experts: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    route_ids = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = route_ids < num_routes
+    local_experts = tl.load(topk_indices_ptr + route_ids, mask=mask, other=0)
+    head_ids = route_ids // routes_per_head
+    global_experts = local_experts + head_ids * num_experts
+    tl.atomic_add(expert_counts_ptr + global_experts, 1, mask=mask)
+
+
+@triton.jit
+def _route_exclusive_scan_kernel(
+    expert_counts_ptr,
+    expert_offsets_ptr,
+    expert_cursors_ptr,
+    num_flatten_experts: tl.constexpr,
+    BLOCK_E: tl.constexpr,
+):
+    expert_ids = tl.arange(0, BLOCK_E)
+    mask = expert_ids < num_flatten_experts
+    counts = tl.load(expert_counts_ptr + expert_ids, mask=mask, other=0)
+    inclusive = tl.cumsum(counts, axis=0)
+    starts = inclusive - counts
+    tl.store(expert_offsets_ptr + expert_ids, starts, mask=mask)
+    tl.store(expert_cursors_ptr + expert_ids, starts, mask=mask)
+    if num_flatten_experts > 0:
+        total = tl.sum(counts, axis=0)
+        tl.store(expert_offsets_ptr + num_flatten_experts, total)
+
+
+@triton.jit
+def _route_scatter_kernel(
+    topk_probs_ptr,
+    topk_indices_ptr,
+    expert_cursors_ptr,
+    gather_ids_ptr,
+    probs_sorted_ptr,
+    route_ids_out_ptr,
+    num_routes: tl.constexpr,
+    sequence: tl.constexpr,
+    top_k: tl.constexpr,
+    routes_per_head: tl.constexpr,
+    num_experts: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    route_ids = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = route_ids < num_routes
+    local_experts = tl.load(topk_indices_ptr + route_ids, mask=mask, other=0)
+    head_ids = route_ids // routes_per_head
+    global_experts = local_experts + head_ids * num_experts
+    destinations = tl.atomic_add(
+        expert_cursors_ptr + global_experts, 1, mask=mask
+    )
+    token_ids = (route_ids // top_k) % sequence
+    probs = tl.load(topk_probs_ptr + route_ids, mask=mask, other=0.0)
+    tl.store(gather_ids_ptr + destinations, token_ids, mask=mask)
+    tl.store(probs_sorted_ptr + destinations, probs, mask=mask)
+    tl.store(route_ids_out_ptr + destinations, route_ids, mask=mask)
+
+
+def flash_mh_moe_direct_csr(
+    topk_probs: torch.Tensor,
+    topk_indices: torch.Tensor,
+    num_experts: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Group routes by expert without a global argsort.
+
+    Returns ``(gather_ids, probs_sorted, expert_offsets, route_ids)`` with the
+    same consumer contract as ``flash_mh_moe_global_sort(..., True)``.  The
+    ordering within each expert is intentionally unspecified.
+    """
+    if topk_probs.ndim != 3 or topk_indices.shape != topk_probs.shape:
+        raise ValueError("top-k probabilities and indices must have shape [H,S,K]")
+    if not topk_probs.is_cuda or not topk_indices.is_cuda:
+        raise ValueError("direct CSR routing requires HCU tensors")
+    if topk_probs.dtype != torch.float32:
+        raise ValueError("direct CSR routing requires FP32 probabilities")
+    if topk_indices.dtype not in (torch.int32, torch.int64):
+        raise ValueError("direct CSR routing requires int32/int64 indices")
+
+    num_heads, sequence, top_k = topk_indices.shape
+    num_routes = num_heads * sequence * top_k
+    num_flatten_experts = num_heads * num_experts
+    if num_flatten_experts > 1024:
+        raise ValueError("direct CSR scan supports at most 1024 flattened experts")
+
+    topk_probs = topk_probs.contiguous()
+    topk_indices = topk_indices.contiguous()
+    expert_counts = torch.zeros(
+        num_flatten_experts, device=topk_indices.device, dtype=torch.int32
+    )
+    expert_offsets = torch.empty(
+        num_flatten_experts + 1, device=topk_indices.device, dtype=torch.int32
+    )
+    expert_cursors = torch.empty_like(expert_counts)
+    gather_ids = torch.empty(
+        num_routes, device=topk_indices.device, dtype=torch.int32
+    )
+    probs_sorted = torch.empty(
+        num_routes, device=topk_probs.device, dtype=torch.float32
+    )
+    route_ids = torch.empty_like(gather_ids)
+
+    block = 256
+    _route_histogram_kernel[(triton.cdiv(num_routes, block),)](
+        topk_indices,
+        expert_counts,
+        num_routes,
+        sequence * top_k,
+        num_experts,
+        BLOCK=block,
+        num_warps=4,
+    )
+    block_e = triton.next_power_of_2(num_flatten_experts)
+    _route_exclusive_scan_kernel[(1,)](
+        expert_counts,
+        expert_offsets,
+        expert_cursors,
+        num_flatten_experts,
+        BLOCK_E=block_e,
+        num_warps=8,
+    )
+    _route_scatter_kernel[(triton.cdiv(num_routes, block),)](
+        topk_probs,
+        topk_indices,
+        expert_cursors,
+        gather_ids,
+        probs_sorted,
+        route_ids,
+        num_routes,
+        sequence,
+        top_k,
+        sequence * top_k,
+        num_experts,
+        BLOCK=block,
+        num_warps=4,
+    )
+    return gather_ids, probs_sorted, expert_offsets, route_ids
diff --git a/inference/flash_mh_moe/triton/router_exact.py b/inference/flash_mh_moe/triton/router_exact.py
new file mode 100644
index 0000000..db2a2a6
--- /dev/null
+++ b/inference/flash_mh_moe/triton/router_exact.py
@@ -0,0 +1,184 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""Small helpers for exact fused-router probability reconstruction."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from inference.common.device import is_dcu
+
+if is_dcu():
+    from triton.language.extra.hip.libdevice import fast_expf
+else:
+    from triton.language.extra.cuda.libdevice import fast_expf
+
+
+@triton.jit
+def _rerank_router_candidates_kernel(
+    router_logits_ptr,
+    candidate_indices_ptr,
+    expert_bias_ptr,
+    topk_probs_ptr,
+    topk_indices_ptr,
+    num_rows: tl.constexpr,
+    sequence: tl.constexpr,
+    num_experts: tl.constexpr,
+    num_candidates: tl.constexpr,
+    top_k: tl.constexpr,
+    BLOCK_ROWS: tl.constexpr,
+):
+    rows = tl.program_id(0) * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+    slots = tl.arange(0, num_candidates)
+    row_mask = rows[:, None] < num_rows
+    candidate_offsets = rows[:, None] * num_candidates + slots[None, :]
+    candidate_indices = tl.load(
+        candidate_indices_ptr + candidate_offsets,
+        mask=row_mask,
+        other=0x7FFFFFFF,
+    )
+    candidate_logits = tl.load(
+        router_logits_ptr + rows[:, None] * num_experts + candidate_indices,
+        mask=row_mask,
+        other=-float("inf"),
+    )
+    # vLLM's HCU top-k sigmoid uses __expf followed by regular FP32 division.
+    # HIP libdevice's fast_expf maps to the same instruction sequence; using
+    # tl.sigmoid/torch.sigmoid differs by one ULP for a meaningful fraction of
+    # logits and is not precise enough for a 100-step diffusion trajectory.
+    candidate_probs = 1.0 / (1.0 + fast_expf(-candidate_logits))
+    head_ids = rows[:, None] // sequence
+    correction_bias = tl.load(
+        expert_bias_ptr + head_ids * num_experts + candidate_indices,
+        mask=row_mask,
+        other=-float("inf"),
+    )
+    choices = candidate_probs + correction_bias
+
+    for k_idx in tl.static_range(0, top_k):
+        max_choice = tl.max(choices, axis=1)
+        tied_indices = tl.where(
+            choices == max_choice[:, None], candidate_indices, 0x7FFFFFFF
+        )
+        selected_index = tl.min(tied_indices, axis=1)
+        selected_mask = candidate_indices == selected_index[:, None]
+        selected_prob = tl.max(
+            tl.where(selected_mask, candidate_probs, -float("inf")), axis=1
+        )
+        out_offsets = rows * top_k + k_idx
+        tl.store(topk_probs_ptr + out_offsets, selected_prob, mask=rows < num_rows)
+        tl.store(topk_indices_ptr + out_offsets, selected_index, mask=rows < num_rows)
+        choices = tl.where(selected_mask, -float("inf"), choices)
+
+
+def rerank_router_candidates_exact(
+    router_logits: torch.Tensor,
+    candidate_indices: torch.Tensor,
+    expert_bias: torch.Tensor,
+    top_k: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Reconstruct vLLM-exact sigmoid values and select the final top-k."""
+    if (
+        router_logits.ndim != 3
+        or candidate_indices.ndim != 3
+        or expert_bias.ndim != 2
+    ):
+        raise ValueError("router logits/candidates must be 3-D and expert bias 2-D")
+    if router_logits.shape[:2] != candidate_indices.shape[:2]:
+        raise ValueError("router logits and candidates must share H/S dimensions")
+    if router_logits.shape[0] != expert_bias.shape[0]:
+        raise ValueError("candidate tensors and expert bias must share heads")
+    if candidate_indices.shape[-1] & (candidate_indices.shape[-1] - 1):
+        raise ValueError("candidate count must be a power of two")
+    if top_k != 6:
+        raise ValueError("the exact normalization kernel currently supports top_k=6")
+    if router_logits.dtype != torch.float32 or not router_logits.is_contiguous():
+        raise ValueError("exact router rerank requires contiguous FP32 logits")
+    if (
+        candidate_indices.dtype != torch.int32
+        or not candidate_indices.is_contiguous()
+    ):
+        raise ValueError("exact router rerank requires contiguous int32 candidates")
+
+    heads, sequence, num_experts = router_logits.shape
+    num_candidates = candidate_indices.shape[-1]
+    num_rows = heads * sequence
+    topk_probs = torch.empty(
+        (heads, sequence, top_k),
+        dtype=torch.float32,
+        device=router_logits.device,
+    )
+    topk_indices = torch.empty(
+        (heads, sequence, top_k),
+        dtype=torch.int32,
+        device=router_logits.device,
+    )
+    block_rows = 64
+    grid = (triton.cdiv(num_rows, block_rows),)
+    _rerank_router_candidates_kernel[grid](
+        router_logits,
+        candidate_indices,
+        expert_bias,
+        topk_probs,
+        topk_indices,
+        num_rows,
+        sequence,
+        num_experts,
+        num_candidates,
+        top_k,
+        BLOCK_ROWS=block_rows,
+        num_warps=4,
+    )
+    return topk_probs, topk_indices
+
+
+@triton.jit
+def _normalize_top6_router_probs_exact_kernel(
+    topk_probs_ptr,
+    num_rows: tl.constexpr,
+    BLOCK_ROWS: tl.constexpr,
+):
+    """Match vLLM's top-6 FP32 reduction order exactly."""
+    rows = tl.program_id(0) * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+    mask = rows < num_rows
+    base = rows * 6
+    p0 = tl.load(topk_probs_ptr + base, mask=mask, other=0.0)
+    p1 = tl.load(topk_probs_ptr + base + 1, mask=mask, other=0.0)
+    p2 = tl.load(topk_probs_ptr + base + 2, mask=mask, other=0.0)
+    p3 = tl.load(topk_probs_ptr + base + 3, mask=mask, other=0.0)
+    p4 = tl.load(topk_probs_ptr + base + 4, mask=mask, other=0.0)
+    p5 = tl.load(topk_probs_ptr + base + 5, mask=mask, other=0.0)
+    denominator = ((((p0 + p1) + p2) + p3) + p4) + p5
+    tl.store(topk_probs_ptr + base, p0 / denominator, mask=mask)
+    tl.store(topk_probs_ptr + base + 1, p1 / denominator, mask=mask)
+    tl.store(topk_probs_ptr + base + 2, p2 / denominator, mask=mask)
+    tl.store(topk_probs_ptr + base + 3, p3 / denominator, mask=mask)
+    tl.store(topk_probs_ptr + base + 4, p4 / denominator, mask=mask)
+    tl.store(topk_probs_ptr + base + 5, p5 / denominator, mask=mask)
+
+
+def normalize_top6_router_probs_exact(topk_probs: torch.Tensor) -> torch.Tensor:
+    """Normalize FP32 top-6 probabilities in place with vLLM-exact math."""
+    if topk_probs.ndim != 3 or topk_probs.shape[-1] != 6:
+        raise ValueError("exact router normalization requires shape [H,S,6]")
+    if topk_probs.dtype != torch.float32 or not topk_probs.is_contiguous():
+        raise ValueError("exact router normalization requires contiguous FP32 input")
+    num_rows = topk_probs.numel() // 6
+    block_rows = 256
+    _normalize_top6_router_probs_exact_kernel[
+        (triton.cdiv(num_rows, block_rows),)
+    ](
+        topk_probs,
+        num_rows,
+        BLOCK_ROWS=block_rows,
+        num_warps=4,
+    )
+    return topk_probs
+
+
+__all__ = [
+    "normalize_top6_router_probs_exact",
+    "rerank_router_candidates_exact",
+]
