diff --git a/inference/model/hcu_vae_rms.py b/inference/model/hcu_vae_rms.py
new file mode 100644
index 0000000..3f2ca16
--- /dev/null
+++ b/inference/model/hcu_vae_rms.py
@@ -0,0 +1,75 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+"""Exact post-reduction RMS conversion for the HCU eager VAE path.
+
+Imported lazily after the caller checks HCU, BF16, contiguous NCHW/NCTHW,
+no affine weight and no active autograd. Compiled ResNets keep their original path.
+input_ptr/output_ptr hold contiguous channel-first elements. inverse_ptr holds one
+FP32 value per batch and spatial position, shared by all channels. SPATIAL_SIZE is
+H*W for NCHW or T*H*W for NCTHW; ELEMENTS is total numel, not the batch count.
+Every call owns a fresh BF16 output.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_vae_rms_postscale_kernel(
+    input_ptr,
+    inverse_ptr,
+    output_ptr,
+    ELEMENTS: tl.constexpr,
+    CHANNELS: tl.constexpr,
+    SPATIAL_SIZE: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    # Cast BEFORE multiplication. Actual ELEMENTS can exceed 2**31.
+    program = tl.program_id(0).to(tl.int64)
+    lanes = tl.arange(0, BLOCK).to(tl.int64)
+    offsets = program * BLOCK + lanes
+    elements64 = tl.full((), ELEMENTS, tl.int64)
+    channels64 = tl.full((), CHANNELS, tl.int64)
+    spatial64 = tl.full((), SPATIAL_SIZE, tl.int64)
+    batch_stride = channels64 * spatial64
+    batch = offsets // batch_stride
+    spatial = offsets % spatial64
+    inverse_offsets = batch * spatial64 + spatial
+    tl.static_assert(offsets.dtype == tl.int64, "global offsets must be int64")
+    tl.static_assert(batch_stride.dtype == tl.int64, "batch stride must be int64")
