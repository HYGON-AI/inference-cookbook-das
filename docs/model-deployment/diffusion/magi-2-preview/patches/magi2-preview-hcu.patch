index 0000000..c182f08
--- /dev/null
+++ b/inference/model/preview_ep_direct_return.py
@@ -0,0 +1,128 @@
+"""Return complete BF16 helper outputs directly to their original token ranks.
+
+This EP8 layout is used only by the existing 32-layer token-helper path. Owners
+0..5 provide both heads for the first four token ranks and their even head for
+the last four. Helpers 6/7 provide odd heads (1,3,5)/(7,9,11) for the last four.
+No floating-point reduction or conversion is performed here.
+"""
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_preview_ep_owner_return_pack_kernel(
+    input_ptr,
+    output_ptr,
+    stride_s,
+    stride_h,
+    stride_d,
+    sequence: tl.constexpr,
+    head_dim: tl.constexpr,
+    block: tl.constexpr,
+):
+    offset = tl.program_id(0) * block + tl.arange(0, block)
+    first_half_size = sequence * head_dim
+    count = first_half_size + sequence // 2 * head_dim
+    first_half = offset < first_half_size
+    tail_offset = offset - first_half_size
+    token = tl.where(first_half, offset // (2 * head_dim), sequence // 2 + tail_offset // head_dim)
+    head = tl.where(first_half, offset // head_dim % 2, 0)
+    channel = offset % head_dim
+    value = tl.load(
+        input_ptr + token * stride_s + head * stride_h + channel * stride_d,
+        mask=offset < count,
+        other=0.0,
+    )
+    tl.store(output_ptr + offset, value, mask=offset < count)
+
+
+@triton.jit
+def hcu_preview_ep_helper_return_unpack_kernel(
+    input_ptr,
+    output_ptr,
+    sequence: tl.constexpr,
+    head_dim: tl.constexpr,
+    tail_rank: tl.constexpr,
+    block: tl.constexpr,
+):
+    offset = tl.program_id(0) * block + tl.arange(0, block)
+    token = offset // (12 * head_dim)
+    head = offset // head_dim % 12
+    channel = offset % head_dim
+    if tail_rank:
+        owner_offset = (head // 2 * sequence + token) * head_dim + channel
+        helper_offset = (
+            6 * sequence * head_dim
+            + (head // 6 * sequence * 3 + token * 3 + head // 2 % 3) * head_dim
+            + channel
+        )
+        source = tl.where(head % 2 == 0, owner_offset, helper_offset)
+    else:
+        source = ((head // 2 * sequence + token) * 2 + head % 2) * head_dim + channel
+    value = tl.load(input_ptr + source, mask=token < sequence, other=0.0)
+    tl.store(output_ptr + offset, value, mask=token < sequence)
+
+
+def return_to_token_ranks(local_output, group, *, after_submit=None):
+    """Unpack one EP exchange to ``[local_tokens, 12, 256]`` on every rank.
+
+    Owner inputs are ``[8*local_tokens, 2, 256]``; the odd head's second half
+    is deliberately unread. Helper inputs are ``[4*local_tokens, 3, 256]``.
+    Both inputs already contain the original complete top-k BF16 reduction.
+    """
+    rank = dist.get_rank(group)
+    assert dist.get_world_size(group) == 8
+    assert local_output.ndim == 3 and local_output.shape[2] == 256
+    assert local_output.dtype == torch.bfloat16 and local_output.is_cuda
+    rows, heads, dim = local_output.shape
+    assert heads == (2 if rank < 6 else 3)
+    divisor = 8 if rank < 6 else 4
+    assert rows > 0 and rows % divisor == 0
+    tokens = rows // divisor
+    unit = tokens * dim
+    if rank < 6:
+        packed = torch.empty(12 * unit, device=local_output.device, dtype=local_output.dtype)
+        hcu_preview_ep_owner_return_pack_kernel[(triton.cdiv(packed.numel(), 1024),)](
+            local_output,
+            packed,
+            *local_output.stride(),
+            sequence=rows,
+            head_dim=dim,
+            block=1024,
+            num_warps=4,
+        )
+        send_counts = [2 * unit] * 4 + [unit] * 4
+    else:
+        packed = local_output.contiguous().view(-1)
+        send_counts = [0] * 4 + [3 * unit] * 4
+    receive_counts = [2 * unit] * 6 + [0, 0] if rank < 4 else [unit] * 6 + [3 * unit] * 2
+    received = torch.empty(12 * unit, device=local_output.device, dtype=local_output.dtype)
+    # Independent projection work runs on the caller while the return is in
+    # flight. Keep the Work and both buffers alive until the ordered unpack.
+    work = dist.all_to_all_single(
+        received,
+        packed,
+        output_split_sizes=receive_counts,
+        input_split_sizes=send_counts,
+        group=group,
+        async_op=after_submit is not None,
+    )
+    if after_submit is not None:
+        try:
+            after_submit()
+        finally:
+            work.wait()
+    output = torch.empty((tokens, 12, dim), device=local_output.device, dtype=local_output.dtype)
+    hcu_preview_ep_helper_return_unpack_kernel[(triton.cdiv(output.numel(), 1024),)](
+        received,
+        output,
+        sequence=tokens,
+        head_dim=dim,
+        tail_rank=rank >= 4,
+        block=1024,
+        num_warps=4,
+    )
+    return output
