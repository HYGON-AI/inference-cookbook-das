+++ b/inference/model/refiner_cp_overlap.py
@@ -0,0 +1,138 @@
+"""Return final video attention rows while the original tail FA computes.
+
+After each all-to-all, V/T are [source rank, local video/tail tokens,
+4, 128]. Restore joins the video/tail token ranges and concatenates the
+8 source ranks along heads, yielding [local tokens, 32, 128]. NV is the
+local video-token count; 512 and 4096 are the per-rank and complete row widths.
+The video callback runs only after all attention partitions have been merged.
+"""
+
+import os
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+
+from inference.common.device import is_dcu
+from inference.model.refiner_fa2_sparse import run_fa2_sparse_attention
+
+_calls = 0
+
+
+def call_count():
+    return _calls
+
+
+def partition_splits(split_sizes, video_tokens):
+    """Intersect each destination's original token interval with video/tail."""
+    start = 0
+    video = []
+    for size in split_sizes:
+        video.append(max(0, min(size, video_tokens - start)))
+        start += size
+    return video, [n - v for n, v in zip(split_sizes, video)]
+
+
+@triton.jit
+def hcu_refiner_cp_attn_output_restore_kernel(
+    V, T, Output, N: tl.constexpr, NV: tl.constexpr, B: tl.constexpr
+):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    row = i // 4096
+    source = i % 4096 // 512
+    column = i % 512
+    is_video = row < NV
+    video = tl.load(V + (source * NV + row) * 512 + column, (row < N) & is_video, 0)
+    tail = tl.load(T + (source * (N - NV) + row - NV) * 512 + column, (row < N) & ~is_video, 0)
+    tl.store(Output + i, tl.where(is_video, video, tail), row < N)
+
+
+def attention(
+    q, k, v, plan, split_sizes, group, optimization_layer=-1, tail_is_text_only=False, overlap=True
+):
+    """Internal CP8 pipeline; overlap=False is a serial scheduling test oracle."""
+    video_splits, tail_splits = partition_splits(split_sizes, plan.video_token_num)
+    rank = dist.get_rank(group)
+    local_video, local_tail = video_splits[rank], tail_splits[rank]
+    video_received = torch.empty((8 * local_video, 4, 128), device=q.device, dtype=q.dtype)
+    tail_received = torch.empty((8 * local_tail, 4, 128), device=q.device, dtype=q.dtype)
+    pending = []
+
+    def start_video(video):
+        work = dist.all_to_all_single(
+            video_received,
+            video,
+            output_split_sizes=[local_video] * 8,
+            input_split_sizes=video_splits,
+            group=group,
+            async_op=True,
+        )
+        pending.append((video, work))
+
+    # Only the callback after ALL residual merges may expose final video rows.
+    # Tail FA reads Q/K/V and writes disjoint output rows, so it has no dependency
+    # on this return exchange. Keep every buffer/Work alive until ordered waits.
+    out, lse = run_fa2_sparse_attention(
+        q,
+        k,
+        v,
+        plan,
+        optimization_layer=optimization_layer,
+        tail_is_text_only=tail_is_text_only,
+        video_ready=start_video if overlap else None,
+    )
+    if not overlap:
+        start_video(out[: plan.video_token_num])
+    tail = out[plan.video_token_num :]
+    tail_work = dist.all_to_all_single(
+        tail_received,
+        tail,
+        output_split_sizes=[local_tail] * 8,
+        input_split_sizes=tail_splits,
+        group=group,
+        async_op=True,
+    )
+    pending[0][1].wait()
+    tail_work.wait()
+    result = torch.empty((split_sizes[rank], 32, 128), device=q.device, dtype=q.dtype)
+    hcu_refiner_cp_attn_output_restore_kernel[(triton.cdiv(result.numel(), 4096),)](
+        video_received.view(torch.int16),
+        tail_received.view(torch.int16),
+        result.view(torch.int16),
+        split_sizes[rank],
+        local_video,
+        4096,
+        num_warps=4,
+    )
+    return result, lse
+
+
+def maybe_attention(
+    q, k, v, plan, split_sizes, group, optimization_layer=-1, tail_is_text_only=False
+):
+    """Return None for the existing non-HCU or unsupported-layout path."""
+    if not (
+        is_dcu()
+        and not torch.is_grad_enabled()
+        and os.environ.get("MAGI2_HCU_DISABLE_REFINER_CP_OVERLAP", "0") != "1"
+        and group is not None
+        and dist.get_world_size(group) == 8
+        and plan.enabled
+        and plan.video_token_num == 514080
+        and plan.total_token_num in (514509, 516109)
+        and len(split_sizes) == 8
+        and min(split_sizes) > 0
+        and sum(split_sizes) == plan.total_token_num
+        and q.is_cuda
+        and q.device == k.device == v.device
+        and q.dtype == k.dtype == v.dtype == torch.bfloat16
+        and q.shape == (plan.total_token_num, 4, 128)
+        and k.shape == v.shape == (plan.total_token_num, 1, 128)
+        and all(x.stride(-1) == 1 for x in (q, k, v))
+        and not (optimization_layer == 29 and tail_is_text_only)
+    ):
+        return None
+    global _calls
+    _calls += 1
+    return attention(q, k, v, plan, split_sizes, group, optimization_layer, tail_is_text_only)[0]
