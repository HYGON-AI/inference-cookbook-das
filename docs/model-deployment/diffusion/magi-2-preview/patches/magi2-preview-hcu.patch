+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Static metadata and bounded residual merging for sparse Refiner FA2.
+
+The HCU sparse kernel consumes 64-token blocks. Refiner blocks are not always
+multiples of 64, so this plan separates full sparse blocks from short residual
+fragments. Their output/LSE pairs are merged with exact online-softmax math.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from inference.common.device import is_dcu
+
+import torch
+
+
+# Keep exact FP32 online-softmax merging without materialising a full
+# [video_tokens, q_heads, head_dim] FP32 tensor.  At 1080p / CP8, one such
+# tensor is about 1 GiB; a 16K-token workspace is about 32 MiB instead.
+_MERGE_CHUNK_TOKENS = 16 * 1024
+
+# Gathering every residual K/V fragment for all 1080p query blocks at once
+# retains roughly 0.8 GiB, and its full residual output adds another 0.5 GiB.
+# Batch only the residual path on whole varlen query sequences.  A 64K-query
+# batch keeps launch overhead modest while bounding those temporaries well
+# below the range-attention peak.
+_RESIDUAL_Q_BATCH_TOKENS = 64 * 1024
+
+# Each residual batch stores sequence/token boundaries followed by the exact
+# maximum Q/K sequence lengths for that batch.  HCU FA2 uses these maxima for
+# tile selection and prefetch bounds, so passing a plan-global maximum to a
+# smaller gathered K/V batch can read past the end of that batch.
+_RESIDUAL_BATCH_META_SIZE = 8
+
+
+@dataclass(frozen=True)
+class Fa2SparsePlan:
+    """Static block table and residual metadata shared by all refiner layers."""
+
+    enabled: bool
+    page_size: int
+    video_token_num: int
+    total_token_num: int
+    page_token_indices: torch.Tensor
+    video_cu_seqlens_q: torch.Tensor
+    video_block_table: torch.Tensor
+    video_seqused_k: torch.Tensor
+    video_max_seqlen_q: int
+    video_max_seqlen_k: int
+    video_residual_token_indices: torch.Tensor
+    video_residual_cu_seqlens_k: torch.Tensor
+    video_residual_max_seqlen_k: int
+    video_residual_batches: list[int]
+    tail_cu_seqlens_q: torch.Tensor
+    tail_block_table: torch.Tensor
+    tail_seqused_k: torch.Tensor
+    tail_max_seqlen_q: int
+    tail_max_seqlen_k: int
+    tail_residual_token_indices: torch.Tensor
+    tail_residual_cu_seqlens_k: torch.Tensor
+    tail_residual_max_seqlen_k: int
+    tail_residual_batches: list[int]
+
+
+def disabled_fa2_sparse_plan(device: torch.device | str) -> Fa2SparsePlan:
+    """Return a carrier plan for layouts which use the range fallback."""
+
+    empty = torch.empty((0,), dtype=torch.int32, device=device)
+    empty_i64 = torch.empty((0,), dtype=torch.int64, device=device)
+    empty_table = torch.empty((0, 0), dtype=torch.int32, device=device)
+    return Fa2SparsePlan(
+        enabled=False,
+        page_size=64,
+        video_token_num=0,
+        total_token_num=0,
+        page_token_indices=empty_i64.view(0, 0),
+        video_cu_seqlens_q=empty,
+        video_block_table=empty_table,
+        video_seqused_k=empty,
+        video_max_seqlen_q=0,
+        video_max_seqlen_k=0,
+        video_residual_token_indices=empty_i64,
+        video_residual_cu_seqlens_k=empty,
+        video_residual_max_seqlen_k=0,
+        video_residual_batches=[],
+        tail_cu_seqlens_q=empty,
+        tail_block_table=empty_table,
+        tail_seqused_k=empty,
+        tail_max_seqlen_q=0,
+        tail_max_seqlen_k=0,
+        tail_residual_token_indices=empty_i64,
+        tail_residual_cu_seqlens_k=empty,
+        tail_residual_max_seqlen_k=0,
+        tail_residual_batches=[],
+    )
+
+
+def _build_residual_batches(
+    cu_q: torch.Tensor,
+    cu_k: torch.Tensor,
+    max_query_tokens: int = _RESIDUAL_Q_BATCH_TOKENS,
+) -> list[int]:
+    """Return aligned sequence, query-token, and key-token batch slices.
+
+    Boundaries always fall between varlen sequences, so each residual FA2 call
+    sees the same query/key sequence pairs as the unbatched call.
+    """
+
+    if max_query_tokens <= 0:
+        raise ValueError("max_query_tokens must be positive")
+    if cu_q.ndim != 1 or cu_k.ndim != 1 or cu_q.shape != cu_k.shape:
+        raise ValueError("residual cu_seqlens_q/k must be matching 1D tensors")
+    q_offsets = cu_q.to(device="cpu", dtype=torch.int64).tolist()
+    k_offsets = cu_k.to(device="cpu", dtype=torch.int64).tolist()
+    if not q_offsets or q_offsets[0] != 0 or k_offsets[0] != 0:
+        raise ValueError("residual cu_seqlens_q/k must start at zero")
+    if any(end < start for start, end in zip(q_offsets, q_offsets[1:])):
+        raise ValueError("residual cu_seqlens_q must be nondecreasing")
+    if any(end < start for start, end in zip(k_offsets, k_offsets[1:])):
+        raise ValueError("residual cu_seqlens_k must be nondecreasing")
+
+    batches: list[int] = []
+
+    def append_batch(sequence_start: int, sequence_end: int) -> None:
+        max_q = max(
+            q_offsets[idx + 1] - q_offsets[idx]
+            for idx in range(sequence_start, sequence_end)
+        )
+        max_k = max(
+            k_offsets[idx + 1] - k_offsets[idx]
+            for idx in range(sequence_start, sequence_end)
+        )
+        batches.extend(
+            [
+                sequence_start,
+                sequence_end,
+                q_offsets[sequence_start],
+                q_offsets[sequence_end],
+                k_offsets[sequence_start],
+                k_offsets[sequence_end],
+                max_q,
+                max_k,
+            ]
+        )
+
+    sequence_count = len(q_offsets) - 1
+    sequence_start: int | None = None
+    for sequence_idx in range(sequence_count):
+        # The HCU FA2 varlen kernel reports +inf LSE for a zero-length K
+        # sequence.  Merging that with the valid page result produces NaNs, so
+        # leave such queries on their already-computed page-only result.
+        if k_offsets[sequence_idx + 1] == k_offsets[sequence_idx]:
+            if sequence_start is not None:
+                append_batch(sequence_start, sequence_idx)
+                sequence_start = None
+            continue
+
+        if sequence_start is None:
+            sequence_start = sequence_idx
+        batch_q_tokens = q_offsets[sequence_idx + 1] - q_offsets[sequence_start]
+        if batch_q_tokens > max_query_tokens and sequence_idx > sequence_start:
+            append_batch(sequence_start, sequence_idx)
+            sequence_start = sequence_idx
+
+    if sequence_start is not None:
+        append_batch(sequence_start, sequence_count)
+    return batches
+
+
+def _check(condition: torch.Tensor | bool, message: str) -> None:
+    if isinstance(condition, torch.Tensor):
+        condition = bool(condition.item())
+    if not condition:
+        raise ValueError(message)
+
+
+def _map_exact_blocks(
+    ranges: torch.Tensor,
+    block_starts: torch.Tensor,
+    blocks: torch.Tensor,
+    name: str,
+) -> torch.Tensor:
+    block_ids = torch.searchsorted(block_starts, ranges[:, 0].contiguous())
+    _check(torch.all(block_ids < blocks.shape[0]), f"{name} starts are invalid")
+    _check(
+        torch.all(blocks[block_ids] == ranges),
+        f"every {name} must exactly match a video block",
+    )
+    return block_ids
+
+
+def _group_pair_items(
+    *,
+    pair_items: torch.Tensor,
+    q_ids: torch.Tensor,
+    pair_counts: torch.Tensor,
+    sentinel: int,
+) -> torch.Tensor:
+    """Group fixed-width per-pair items into dense rows by query block."""
+
+    num_blocks = int(pair_counts.shape[0])
+    max_pairs = int(pair_counts.max().item())
+    order = torch.argsort(q_ids, stable=True)
+    sorted_q_ids = q_ids[order]
+    group_offsets = torch.cumsum(pair_counts, dim=0) - pair_counts
+    slots = torch.arange(q_ids.numel(), device=q_ids.device, dtype=torch.int64)
+    slots = slots - torch.repeat_interleave(group_offsets, pair_counts)
+    grouped = torch.full(
+        (num_blocks, max_pairs, pair_items.shape[1]),
+        sentinel,
+        device=q_ids.device,
+        dtype=pair_items.dtype,
+    )
+    grouped[sorted_q_ids, slots] = pair_items[order]
+    return grouped.flatten(1)
+
+
+def _compact_rows(
+    rows: torch.Tensor, sentinel: int, duplicate_message: str
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Sort rows, reject duplicates, and return dense rows plus valid counts."""
+
+    rows = torch.sort(rows, dim=1).values
+    valid = rows < sentinel
+    duplicates = (
+        (rows[:, 1:] == rows[:, :-1]) & valid[:, 1:] & valid[:, :-1]
+    )
+    _check(not torch.any(duplicates), duplicate_message)
+    counts = valid.sum(dim=1, dtype=torch.int64)
+    width = int(counts.max().item()) if counts.numel() else 0
+    rows = rows[:, :width]
+    rows = torch.where(rows < sentinel, rows, torch.zeros_like(rows))
+    return rows, counts
+
+
+@torch.no_grad()
+def build_fa2_sparse_plan(
+    *,
+    video_block_ranges: torch.Tensor,
+    window_q_ranges: torch.Tensor,
+    window_k_ranges: torch.Tensor,
+    total_token_num: int,
+    page_size: int = 64,
+) -> Fa2SparsePlan:
+    """Build the exact sparse block-table plus residual plan for HCU FA2."""
+
+    if page_size != 64:
+        raise ValueError("the installed HCU sparse FA2 kernel requires page_size=64")
+    if video_block_ranges.ndim != 2 or video_block_ranges.shape[1] != 2:
+        raise ValueError("video_block_ranges must have shape [num_blocks, 2]")
+    if window_q_ranges.shape != window_k_ranges.shape:
+        raise ValueError("window q/k ranges must have identical shapes")
+    if window_q_ranges.ndim != 2 or window_q_ranges.shape[1] != 2:
+        raise ValueError("window q/k ranges must have shape [num_pairs, 2]")
+    if video_block_ranges.shape[0] == 0 or window_q_ranges.shape[0] == 0:
+        raise ValueError("sparse refiner attention requires blocks and window pairs")
+
+    device = video_block_ranges.device
+    if window_q_ranges.device != device or window_k_ranges.device != device:
+        raise ValueError("video and window ranges must be on the same device")
+    blocks = video_block_ranges.to(torch.int64)
+    q_ranges = window_q_ranges.to(torch.int64)
+    k_ranges = window_k_ranges.to(torch.int64)
+    block_starts, block_ends = (
+        part.contiguous() for part in blocks.unbind(dim=1)
+    )
+    block_lengths = block_ends - block_starts
+    video_token_num = int(block_ends[-1].item())
+    total_token_num = int(total_token_num)
+
+    _check(block_starts[0] == 0, "video blocks must start at token zero")
+    _check(
+        torch.all(block_starts[1:] == block_ends[:-1]),
+        "video blocks must form a contiguous partition",
+    )
+    _check(torch.all(block_lengths > 0), "video blocks must be non-empty")
+    _check(
+        total_token_num >= video_token_num,
+        "total_token_num must not be smaller than the video token count",
+    )
+    q_ids = _map_exact_blocks(q_ranges, block_starts, blocks, "window query range")
+    k_ids = _map_exact_blocks(k_ranges, block_starts, blocks, "window key range")
+
+    num_blocks = int(blocks.shape[0])
+    pair_counts = torch.bincount(q_ids, minlength=num_blocks)
+    _check(
+        torch.all(pair_counts > 0),
+        "every video query block must have at least one local key block",
+    )
+
+    # Repack every complete 64-token chunk into physical cache pages. This is
+    # one O(sequence) gather per layer, independent of neighbourhood fan-out.
+    block_page_counts = torch.div(block_lengths, page_size, rounding_mode="floor")
+    _check(
+        torch.all(block_page_counts > 0),
+        "every video block must contain at least one complete FA2 page",
+    )
+    max_block_pages = int(block_page_counts.max().item())
+    page_offsets = torch.arange(max_block_pages, device=device, dtype=torch.int64)
+    block_page_bases = torch.cumsum(block_page_counts, dim=0) - block_page_counts
+    block_page_ids = block_page_bases[:, None] + page_offsets[None, :]
+    valid_block_pages = page_offsets[None, :] < block_page_counts[:, None]
+
+    token_offsets = torch.arange(page_size, device=device, dtype=torch.int64)
+    block_page_tokens = (
+        block_starts[:, None, None]
+        + page_offsets[None, :, None] * page_size
+        + token_offsets[None, None, :]
+    )
+    page_token_indices = block_page_tokens[valid_block_pages]
+    video_physical_pages = int(block_page_counts.sum().item())
+
+    tail_token_num = total_token_num - video_token_num
+    tail_full_pages = tail_token_num // page_size
+    if tail_full_pages:
+        tail_page_tokens = (
+            video_token_num
+            + torch.arange(tail_full_pages, device=device, dtype=torch.int64)[:, None]
+            * page_size
+            + token_offsets[None, :]
+        )
+        page_token_indices = torch.cat((page_token_indices, tail_page_tokens), dim=0)
+    num_physical_pages = video_physical_pages + tail_full_pages
+    _check(num_physical_pages > 0, "sparse attention requires a complete 64-token block")
+
+    page_sentinel = num_physical_pages
+    block_page_ids = torch.where(
+        valid_block_pages, block_page_ids, torch.full_like(block_page_ids, page_sentinel)
+    )
+    pair_pages = block_page_ids[k_ids]
+    video_pages = _group_pair_items(
+        pair_items=pair_pages,
+        q_ids=q_ids,
+        pair_counts=pair_counts,
+        sentinel=page_sentinel,
+    )
+    if tail_full_pages:
+        tail_page_ids = torch.arange(
+            video_physical_pages,
+            num_physical_pages,
+            device=device,
+            dtype=torch.int64,
+        )
+        video_pages = torch.cat(
+            (video_pages, tail_page_ids.expand(num_blocks, -1)), dim=1
+        )
+    video_pages, video_page_counts = _compact_rows(
+        video_pages,
+        page_sentinel,
+        "overlapping key ranges produced duplicate physical pages",
+    )
+
+    # Keep only the <64-token suffix of each selected logical block for the
+    # residual FA2 call. Full blocks contribute zero residual tokens.
+    residual_width = page_size - 1
+    residual_offsets = torch.arange(residual_width, device=device, dtype=torch.int64)
+    block_residual_counts = block_lengths.remainder(page_size)
+    block_residuals = (
+        block_starts[:, None]
+        + block_page_counts[:, None] * page_size
+        + residual_offsets[None, :]
+    )
+    token_sentinel = total_token_num
+    block_residuals = torch.where(
+        residual_offsets[None, :] < block_residual_counts[:, None],
+        block_residuals,
+        torch.full_like(block_residuals, token_sentinel),
+    )
+    pair_residuals = block_residuals[k_ids]
+    video_residuals = _group_pair_items(
+        pair_items=pair_residuals,
+        q_ids=q_ids,
+        pair_counts=pair_counts,
+        sentinel=token_sentinel,
+    )
+    tail_residual_start = video_token_num + tail_full_pages * page_size
+    tail_residual = torch.arange(
+        tail_residual_start, total_token_num, device=device, dtype=torch.int64
+    )
+    if tail_residual.numel():
+        video_residuals = torch.cat(
+            (video_residuals, tail_residual.expand(num_blocks, -1)), dim=1
+        )
+    video_residuals, video_residual_counts = _compact_rows(
+        video_residuals,
+        token_sentinel,
+        "overlapping key ranges produced duplicate residual tokens",
+    )
+    video_residual_mask = (
+        torch.arange(video_residuals.shape[1], device=device)[None, :]
+        < video_residual_counts[:, None]
+    )
+    video_residual_token_indices = video_residuals[video_residual_mask]
+    video_residual_cu_k = torch.cat(
+        (
+            torch.zeros((1,), device=device, dtype=torch.int64),
+            torch.cumsum(video_residual_counts, dim=0),
+        )
+    ).to(torch.int32)
+
+    video_cu_q = torch.cat(
+        (torch.zeros((1,), device=device, dtype=torch.int64), block_ends)
+    ).to(torch.int32)
+    video_seqused_k = (video_page_counts * page_size).to(torch.int32)
+
+    if tail_token_num > 0:
+        tail_cu_q = torch.tensor([0, tail_token_num], device=device, dtype=torch.int32)
+        tail_block_table = torch.arange(
+            num_physical_pages, device=device, dtype=torch.int32
+        ).view(1, -1)
+        tail_seqused_k = torch.tensor(
+            [num_physical_pages * page_size], device=device, dtype=torch.int32
+        )
+        all_block_residuals = block_residuals[block_residuals < token_sentinel]
+        tail_residual_token_indices = torch.cat(
+            (all_block_residuals, tail_residual), dim=0
+        )
+        tail_residual_count = int(tail_residual_token_indices.numel())
+        tail_residual_cu_k = torch.tensor(
+            [0, tail_residual_count], device=device, dtype=torch.int32
+        )
+    else:
+        tail_cu_q = torch.zeros((1,), device=device, dtype=torch.int32)
+        tail_block_table = torch.empty((0, 0), device=device, dtype=torch.int32)
+        tail_seqused_k = torch.empty((0,), device=device, dtype=torch.int32)
+        tail_residual_token_indices = torch.empty(
+            (0,), device=device, dtype=torch.int64
+        )
+        tail_residual_cu_k = torch.zeros((1,), device=device, dtype=torch.int32)
+        tail_residual_count = 0
+
+    return Fa2SparsePlan(
+        enabled=True,
+        page_size=page_size,
+        video_token_num=video_token_num,
+        total_token_num=total_token_num,
+        page_token_indices=page_token_indices.contiguous(),
+        video_cu_seqlens_q=video_cu_q.contiguous(),
+        video_block_table=video_pages.to(torch.int32).contiguous(),
+        video_seqused_k=video_seqused_k.contiguous(),
+        video_max_seqlen_q=int(block_lengths.max().item()),
+        video_max_seqlen_k=int(video_seqused_k.max().item()),
+        video_residual_token_indices=video_residual_token_indices.contiguous(),
+        video_residual_cu_seqlens_k=video_residual_cu_k.contiguous(),
+        video_residual_max_seqlen_k=int(video_residual_counts.max().item()),
+        video_residual_batches=_build_residual_batches(video_cu_q, video_residual_cu_k),
+        tail_cu_seqlens_q=tail_cu_q.contiguous(),
+        tail_block_table=tail_block_table.contiguous(),
+        tail_seqused_k=tail_seqused_k.contiguous(),
+        tail_max_seqlen_q=tail_token_num,
+        tail_max_seqlen_k=num_physical_pages * page_size if tail_token_num else 0,
+        tail_residual_token_indices=tail_residual_token_indices.contiguous(),
+        tail_residual_cu_seqlens_k=tail_residual_cu_k.contiguous(),
+        tail_residual_max_seqlen_k=tail_residual_count,
+        tail_residual_batches=_build_residual_batches(tail_cu_q, tail_residual_cu_k),
+    )
+
+
+def _merge_attention_parts(
+    page_output: torch.Tensor,
+    page_lse: torch.Tensor,
+    residual_output: torch.Tensor,
+    residual_lse: torch.Tensor,
+    *,
+    output: torch.Tensor,
+    output_lse: torch.Tensor,
+    chunk_tokens: int = _MERGE_CHUNK_TOKENS,
+) -> None:
+    """Merge disjoint key-set results in bounded-memory FP32 chunks.
+
+    ``page_lse`` is stored as ``[tokens, heads]`` in ``output_lse`` while the
+    HCU FA2 residual LSE is returned as ``[heads, tokens]``.  ``output`` may
+    alias ``page_output``; each chunk is converted to FP32 before that chunk is
+    overwritten, preserving the exact online-softmax merge arithmetic.
+    """
+
+    if chunk_tokens <= 0:
+        raise ValueError("chunk_tokens must be positive")
+    if (
+        page_output.shape != residual_output.shape
+        or output.shape != page_output.shape
+    ):
+        raise ValueError("attention outputs must have identical shapes")
+    if page_lse.shape != output_lse.shape:
+        raise ValueError("page and output LSE tensors must have identical shapes")
+    if residual_lse.shape != (page_lse.shape[1], page_lse.shape[0]):
+        raise ValueError("residual LSE must have shape [heads, tokens]")
+
+    vector_merge = None
+    if is_dcu():
+        from inference.model.refiner_merge import merge_vectors, supports_vector_merge
+
+        if supports_vector_merge(page_output, residual_output, output, output_lse):
+            vector_merge = merge_vectors
+
+    token_num = int(page_output.shape[0])
+    if vector_merge is not None:
+        chunk_tokens = max(1, min(token_num, 65536))
+    for start in range(0, token_num, chunk_tokens):
+        end = min(start + chunk_tokens, token_num)
+        page_lse_chunk = page_lse[start:end].float()
+        residual_lse_chunk = residual_lse[:, start:end].transpose(0, 1).float()
+        merged_lse = torch.logaddexp(page_lse_chunk, residual_lse_chunk)
+        page_weight = torch.exp(page_lse_chunk - merged_lse).unsqueeze(-1)
+        residual_weight = torch.exp(residual_lse_chunk - merged_lse).unsqueeze(-1)
+
+        if vector_merge is not None:
+            vector_merge(
+                page_output[start:end],
+                residual_output[start:end],
+                page_weight,
+                residual_weight,
+                merged_lse,
+                output[start:end],
+                output_lse[start:end],
+            )
+            continue
+
+        # Use only two chunk-sized FP32 output workspaces.  The old whole-video
+        # expression held several ~1 GiB FP32 temporaries concurrently.
+        merged_output = page_output[start:end].float()
+        merged_output.mul_(page_weight)
+        residual_output_chunk = residual_output[start:end].float()
+        residual_output_chunk.mul_(residual_weight)
+        merged_output.add_(residual_output_chunk)
+        output[start:end].copy_(merged_output)
+        output_lse[start:end].copy_(merged_lse)
+
+
+def _run_residual_partition(
+    *,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    cu_q: torch.Tensor,
+    residual_indices: torch.Tensor,
+    residual_cu_k: torch.Tensor,
+    residual_batches: list[int],
+    output: torch.Tensor,
+    output_lse: torch.Tensor,
+) -> None:
+    """Run residual K fragments and merge them into an existing page result."""
+
+    from flash_attn.flash_attn_interface import flash_attn_varlen_func
+
+    if residual_indices.numel() == 0:
+        return
+
+    if not residual_batches:
+        raise ValueError("residual attention requires at least one aligned batch")
+    if len(residual_batches) % _RESIDUAL_BATCH_META_SIZE:
+        raise ValueError("residual batch metadata must contain eight integers per batch")
+    for batch_start in range(0, len(residual_batches), _RESIDUAL_BATCH_META_SIZE):
+        (
+            seq_start,
+            seq_end,
+            q_start,
+            q_end,
+            k_start,
+            k_end,
+            batch_max_q,
+            batch_max_k,
+        ) = residual_batches[
+            batch_start : batch_start + _RESIDUAL_BATCH_META_SIZE
+        ]
+        gathered = None
+        if is_dcu():
+            from inference.model.refiner_gather import gather_pair
+
+            gathered = gather_pair(key, value, residual_indices[k_start:k_end])
+        if gathered is None:
+            residual_key = key[residual_indices[k_start:k_end]]
+            residual_value = value[residual_indices[k_start:k_end]]
+        else:
+            residual_key, residual_value = gathered
+            del gathered
+        batch_cu_q = cu_q[seq_start : seq_end + 1] - q_start
+        batch_cu_k = residual_cu_k[seq_start : seq_end + 1] - k_start
+        residual_output, residual_lse, _ = flash_attn_varlen_func(
+            query[q_start:q_end],
+            residual_key,
+            residual_value,
+            batch_cu_q,
+            batch_cu_k,
+            batch_max_q,
+            batch_max_k,
+            return_attn_probs=True,
+        )
+        del residual_key, residual_value
+        _merge_attention_parts(
+            output[q_start:q_end],
+            output_lse[q_start:q_end],
+            residual_output,
+            residual_lse,
+            output=output[q_start:q_end],
+            output_lse=output_lse[q_start:q_end],
+        )
