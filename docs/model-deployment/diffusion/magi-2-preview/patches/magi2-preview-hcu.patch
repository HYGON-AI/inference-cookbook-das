+++ b/inference/model/refiner_qkv_prepare.py
@@ -0,0 +1,114 @@
+"""Exact BF16 QKV gather/cast/square; the original ATen mean remains external.
+
+Q is BF16 [source_tokens, 32, 128]; K/V have 8 heads. The inner head
+and channel dimensions are contiguous; Q0/K0/V0 are independent token
+strides. M maps each output token to an input token. QF/QS and KF/KS are
+contiguous FP32 values/squares; VO is the caller-owned BF16 gathered V.
+4096 and 1024 are the flattened Q and K/V row widths. No reduction is fused.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def hcu_refiner_qkv_gather_cast_square_kernel(
+    Q,
+    K,
+    V,
+    M,
+    QF,
+    QS,
+    KF,
+    KS,
+    VO,
+    Q0: tl.constexpr,
+    K0: tl.constexpr,
+    V0: tl.constexpr,
+    B: tl.constexpr,
+):
+    QB: tl.constexpr = (4096 + B - 1) // B
+    KB: tl.constexpr = (1024 + B - 1) // B
+    pid = tl.program_id(0)
+    row = pid // (QB + KB)
+    tile = pid % (QB + KB)
+    src = tl.load(M + row)
+    if tile < QB:
+        col = tile * B + tl.arange(0, B)
+        mask = col < 4096
+        x = tl.load(Q + src * Q0 + col, mask, 0).to(tl.float32)
+        tl.store(QF + row * 4096 + col, x, mask)
+        tl.store(QS + row * 4096 + col, x * x, mask)
+    else:
+        col = (tile - QB) * B + tl.arange(0, B)
+        mask = col < 1024
+        x = tl.load(K + src * K0 + col, mask, 0).to(tl.float32)
+        v = tl.load(V + src * V0 + col, mask, 0)
+        tl.store(KF + row * 1024 + col, x, mask)
+        tl.store(KS + row * 1024 + col, x * x, mask)
+        tl.store(VO + row * 1024 + col, v, mask)
+
+
+def prepare(q, k, v, source, out_v, block=512):
+    n = source.numel()
+    assert q.shape[1:] == (32, 128) and k.shape[1:] == v.shape[1:] == (8, 128)
+    assert all(
+        x.dtype == torch.bfloat16 and x.stride(1) == 128 and x.stride(2) == 1 for x in (q, k, v)
+    )
+    assert source.dtype == torch.int64 and source.is_contiguous()
+    assert out_v.shape == (n, 8, 128) and out_v.is_contiguous() and out_v.dtype == torch.bfloat16
+    qf = torch.empty((n, 32, 128), device=q.device, dtype=torch.float32)
+    qs = torch.empty_like(qf)
+    kf = torch.empty((n, 8, 128), device=q.device, dtype=torch.float32)
+    ks = torch.empty_like(kf)
+    hcu_refiner_qkv_gather_cast_square_kernel[
+        (n * (triton.cdiv(4096, block) + triton.cdiv(1024, block)),)
+    ](
+        q,
+        k,
+        v,
+        source,
+        qf,
+        qs,
+        kf,
+        ks,
+        out_v,
+        q.stride(0),
+        k.stride(0),
+        v.stride(0),
+        block,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return qf, qs, kf, ks, out_v
+
+
+def supports_prepare(q, k, v, source):
+    if torch.is_grad_enabled() or not torch.version.hip or not q.is_cuda:
+        return False
+    if (
+        q.ndim != 3
+        or k.ndim != 3
+        or v.ndim != 3
+        or q.shape[1:] != (32, 128)
+        or k.shape[1:] != (8, 128)
+        or v.shape != k.shape
+    ):
+        return False
+    if q.shape[0] != k.shape[0] or any(
+        t.dtype != torch.bfloat16 or t.device != q.device for t in (q, k, v)
+    ):
+        return False
+    if any(
+        t.stride(1) != 128 or t.stride(2) != 1 or t.stride(0) < t.shape[1] * 128 for t in (q, k, v)
+    ):
+        return False
+    if (
+        source.ndim != 1
+        or source.dtype != torch.int64
+        or source.device != q.device
+        or not source.is_contiguous()
+    ):
+        return False
+    return torch.cuda.get_device_properties(q.device).gcnArchName.split(":")[0] == "gfx936"
