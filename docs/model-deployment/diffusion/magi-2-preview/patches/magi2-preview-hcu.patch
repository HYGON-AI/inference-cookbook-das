@@ -0,0 +1,48 @@
+# Copyright (c) 2026 SandAI. All Rights Reserved.
+# Apache-2.0.
+"""CP8/EP8 preview exchange without the four dummy MoE heads.
+
+The ownership of all 12 real heads and every route stays unchanged. All eight
+ranks still participate, with zero-size splits for the two dummy owners.
+"""
+import torch
+import torch.distributed as dist
+from .preview_ep_pack import preview_ep_dispatch_pack, preview_ep_undispatch_unpack
+
+
+def dispatch_unpadded(x, group):
+    sequence, heads, dim = x.shape
+    assert heads == 12 and dist.get_world_size(group) == 8
+    owner = dist.get_rank(group)
+    local_heads = 2 if owner < 6 else 0
+    packed = preview_ep_dispatch_pack(x, 6).reshape(-1)
+    unit = sequence * 2 * dim
+    received = torch.empty((8 * sequence * local_heads * dim,), device=x.device, dtype=x.dtype)
+    dist.all_to_all_single(
+        received,
+        packed,
+        output_split_sizes=[sequence * local_heads * dim] * 8,
+        input_split_sizes=[unit] * 6 + [0, 0],
+        group=group,
+    )
+    return received.view(8 * sequence, local_heads, dim)
+
+
+def undispatch_unpadded(x, group, *, after_submit=None):
+    total_sequence, local_heads, dim = x.shape
+    sequence = total_sequence // 8
+    received = torch.empty((6 * sequence * 2 * dim,), device=x.device, dtype=x.dtype)
+    work = dist.all_to_all_single(
+        received,
+        x.contiguous().reshape(-1),
+        output_split_sizes=[sequence * 2 * dim] * 6 + [0, 0],
+        input_split_sizes=[sequence * local_heads * dim] * 8,
+        group=group,
+        async_op=after_submit is not None,
+    )
+    if after_submit is not None:
+        try:
+            after_submit()
+        finally:
+            work.wait()
+    return preview_ep_undispatch_unpack(received.view(6, sequence, 2, dim), 12)
