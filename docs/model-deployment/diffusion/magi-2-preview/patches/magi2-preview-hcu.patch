@@ -0,0 +1,48 @@
+"""Exact BF16 swiglu7 inference fusion with the original HCU FP32 operation boundaries.
+
+Only the default alpha/limit and contiguous BF16 projections are supported.
+The caller retains the original implementation for all other inputs.
+"""
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+
+@triton.jit
+def hcu_refiner_swiglu7_kernel(X, Y, N: tl.constexpr, BLOCK: tl.constexpr):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    a = tl.load(X + 2 * i, i < N, 0).to(tl.float32)
+    b = tl.load(X + 2 * i + 1, i < N, 0).to(tl.float32)
+    a = tl.minimum(a, 7.0, propagate_nan=tl.PropagateNan.ALL)
+    b = tl.maximum(
+        tl.minimum(b, 7.0, propagate_nan=tl.PropagateNan.ALL),
+        -7.0,
+        propagate_nan=tl.PropagateNan.ALL,
+    )
+    z = 1.702 * a
+    sigmoid = tl.div_rn(1.0, 1.0 + libdevice.exp(-z))
+    y = (a * sigmoid) * (b + 1.0)
+    bf16 = y.to(tl.bfloat16)
+    # ATen's HCU float->BF16 copy canonicalizes NaN to 0x7fc0, whereas
+    # Triton's ordinary cast uses 0x7fff. Preserve the original output bits.
+    bf16 = tl.where(
+        y != y,
+        tl.full((), 0x7FC0, tl.uint16).to(tl.bfloat16, bitcast=True),
+        bf16,
+    )
+    tl.store(Y + i, bf16, i < N)
+
+
+def fused_swiglu7(x: torch.Tensor) -> torch.Tensor:
+    if not x.is_cuda or x.dtype != torch.bfloat16 or x.ndim != 2 or not x.is_contiguous():
+        raise ValueError("fused swiglu7 requires a contiguous 2D BF16 projection")
+    if x.shape[-1] % 2:
+        raise ValueError("swiglu7 requires paired gate/linear columns")
+    out = torch.empty((x.shape[0], x.shape[1] // 2), dtype=x.dtype, device=x.device)
+    if out.numel():
+        hcu_refiner_swiglu7_kernel[(triton.cdiv(out.numel(), 1024),)](
+            x, out, out.numel(), 1024, num_warps=4, enable_fp_fusion=False
+        )
+    return out
