@@ -0,0 +1,27 @@
+"""Runtime device detection shared by hardware-specific inference paths."""
+
+from __future__ import annotations
+
+import os
+import shutil
+
+import torch
+
+
+_IS_DCU = torch.version.hip is not None and shutil.which("hy-smi") is not None
+
+
+def is_dcu() -> bool:
+    """Return whether this process is using the HCU/DCU PyTorch runtime.
+
+    ``hy-smi`` alone is insufficient because the utility may be installed in a
+    CUDA environment.  Requiring both the HIP PyTorch build and the HCU system
+    utility keeps NVIDIA processes on the upstream implementation.
+    """
+
+    return _IS_DCU
+
+
+def use_hcu_preview_helper() -> bool:
+    """Choose helper weight layout before loading; use the same override on all ranks."""
+    return is_dcu() and os.environ.get("MAGI2_HCU_DISABLE_PREVIEW_HELPER", "0") != "1"
