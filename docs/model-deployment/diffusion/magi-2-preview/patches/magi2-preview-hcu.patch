+            partial_out_ptr
+            + split_idx * partial_out_stride_s
+            + token[:, None] * partial_out_stride_t
+            + output[None, :] * partial_out_stride_o,
+            mask=token_mask[:, None] & output_mask[None, :],
+            other=0.0,
